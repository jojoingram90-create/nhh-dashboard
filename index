<script>
/* ---------------- Mock data (mirrors the Supabase schema in the design spec) ---------------- */
// ---- Live date/time engine ----
// Everything below reads the REAL current date/time rather than a fixed demo snapshot, so the app
// keeps working correctly day after day at a real house instead of being frozen on one walkthrough
// date. TODAY/TODAY_SHORT/TODAY_ISO/TODAY_DOW are refreshed once per render() (see refreshTodayIfNeeded)
// so a shared iPad left open overnight rolls into the new day on its own next render, without needing
// a page reload.
function pad2(n){ return String(n).padStart(2,"0"); }
function isoDate(d){ return `${d.getFullYear()}-${pad2(d.getMonth()+1)}-${pad2(d.getDate())}`; }
function parseIso(s){ const [y,m,dd] = s.split("-").map(Number); return new Date(y, m-1, dd); }
function addDaysIso(s, n){ const d = parseIso(s); d.setDate(d.getDate()+n); return isoDate(d); }
function addMonthsIso(s, n){ const d = parseIso(s); d.setMonth(d.getMonth()+n); return isoDate(d); }
const DOW_SHORT = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
const DOW_LONG = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
const MONTH_LONG = ["January","February","March","April","May","June","July","August","September","October","November","December"];
function fmtLong(d){ return `${DOW_LONG[d.getDay()]}, ${MONTH_LONG[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`; }
function fmtShort(d){ return `${DOW_SHORT[d.getDay()]} ${MONTH_LONG[d.getMonth()].slice(0,3)} ${d.getDate()}`; }
function fmtDayLabel(d){ return `${DOW_SHORT[d.getDay()]} ${d.getDate()}`; }
function nowRef(){ return new Date(); } // the real current moment — replaces the old fixed NOW_REF
function todayIso(){ return isoDate(nowRef()); }
let TODAY = fmtLong(nowRef());
let TODAY_SHORT = fmtShort(nowRef());
let TODAY_ISO = todayIso();
let TODAY_DOW = DOW_SHORT[nowRef().getDay()];
function refreshTodayIfNeeded(){
  const iso = todayIso();
  if(iso !== TODAY_ISO){
    TODAY_ISO = iso;
    TODAY = fmtLong(nowRef());
    TODAY_SHORT = fmtShort(nowRef());
    TODAY_DOW = DOW_SHORT[nowRef().getDay()];
  }
}

