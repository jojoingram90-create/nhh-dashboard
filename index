// renderSidebar()). Besides landing back on the Dashboard, this clears every resident-id-shaped bit of
// state left over from the old house — none of those residents exist in the new house's list, and
// leaving a stale id around risks a lookup silently resolving to nothing (or, worse, to a same-id
// resident that happens to exist in both houses) the next time one of those screens renders.
function setHouse(h){
  state.house = h;
  state.view = "dashboard";
  state.residentId = null;
  state.dcResidentId = null;
  state.incidentResidentId = null;
  state.incidentReportId = null;
  state.breakfastPrefsOpen = false;
  state.breakfastPrefsResidentId = null;
  state.residentStatusOpen = false;
  state.residentStatusDraft = null;
  state.calendarModal = null;
  state.recipeModal = null;
  state.menuEditing = false;
  state.mealTimesEditing = false;
  render();
}
