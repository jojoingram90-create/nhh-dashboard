/* ---------------- Medications: Today's Flow "Log Meds" quick-log ----------------
   Tapping the Medications task opens two big buttons — a green PASS (marks every medication due at
   this resident/time as taken, in one tap) and a red REFUSE (opens a checklist so the caregiver picks
   exactly which of the due medications were actually refused — the rest are passed). This replaces the
   old per-medication Pass/Refuse row-by-row flow, and there's no separate checkbox anymore: logging
   PASS or REFUSE for everyone due here IS what marks this task done (see isFlowRowDone). */
function medFlowBlock(residentId, anchor, meds){
  if(!meds.length) return { button:"", panel:"" };
  const dc = getDC(residentId);
  const recs = meds.map(med=>(dc.medications||{})[medLogKey(med.id, anchor)]);
  const loggedCount = recs.filter(Boolean).length;
  const total = meds.length;
  const allDone = loggedCount === total;
  const anyRefused = recs.some(rec=>rec && rec.status==="refuse");
  const flowKey = residentId+'|'+anchor;
  const expanded = state.expandedMedLogKey === flowKey;
  const summary = allDone ? (anyRefused ? `${recs.filter(r=>r.status==="refuse").length} of ${total} refused` : `All ${total} passed`) : `${loggedCount}/${total} logged`;
  const button = allDone
    ? `<div class="dc-stamp-editable"><span class="dc-stamp" style="color:${anyRefused?'var(--alert-text)':'var(--good-text)'};">💊 ${summary} ✓</span><button class="btn small" onclick="toggleMedQuickLog('${residentId}','${anchor}')">✎ Change</button></div>`
    : `<button class="btn primary task-log-btn" onclick="toggleMedQuickLog('${residentId}','${anchor}')">💊 Log Medications</button>`;
  const panel = expanded ? medQuickLogPanel(residentId, anchor, meds) : "";
  return { button, panel };
}
function toggleMedQuickLog(residentId, anchor){
  const key = residentId+'|'+anchor;
  state.expandedMedLogKey = state.expandedMedLogKey===key ? null : key;
  state.medChoosingRefuse = false;
  state.medRefuseDraft = {};
  scheduleRender();
}
function medQuickLogPanel(residentId, anchor, meds){
  const dc = getDC(residentId);
  if(state.medChoosingRefuse){
    return medRefuseChoicePanel(residentId, anchor, meds);
  }
  return `<div class="card routine-quicklog" onclick="event.stopPropagation()">
    <div class="dc-label">Medications due — writes to Daily Care</div>
    <div class="cp-hint" style="margin-bottom:10px;">${meds.map(m=>esc(m.name)+(m.dosage?` (${esc(m.dosage)})`:"")).join(", ")}</div>
    <div class="task-log-options">
      <button type="button" class="task-log-opt pass" onclick="passAllMedications('${residentId}','${anchor}')">✓ PASS<br><span style="font-weight:500; font-size:12px;">All taken</span></button>
      <button type="button" class="task-log-opt refuse" onclick="startRefuseChoice('${residentId}','${anchor}')">✕ REFUSE<br><span style="font-weight:500; font-size:12px;">Choose which</span></button>
    </div>
  </div>`;
}
// Every due medication defaults to Pass — the caregiver only has to actively pick the ones that were
// actually refused, not re-confirm every medication that went fine.
function passAllMedications(residentId, anchor){
  const meds = allDueMedsForAnchor(residentId, anchor);
  meds.forEach(med=>setMedStatus(residentId, med.id, anchor, "pass", ""));
  state.expandedMedLogKey = null;
  scheduleRender();
}
function allDueMedsForAnchor(residentId, anchor){
  const cp = carePlans[residentId];
  return (cp.medications||[]).filter(med=>medAnchorsForMed(med).some(a=>a.anchor===anchor));
}
function startRefuseChoice(residentId, anchor){
  const dc = getDC(residentId);
  const meds = allDueMedsForAnchor(residentId, anchor);
  const draft = {};
  meds.forEach(med=>{
    const rec = (dc.medications||{})[medLogKey(med.id, anchor)];
    draft[med.id] = { refused: !!(rec && rec.status==="refuse"), reason: (rec && rec.reason) || "" };
  });
  state.medChoosingRefuse = true;
  state.medRefuseDraft = draft;
  scheduleRender();
}
function toggleMedRefuseDraft(medId){
  if(!state.medRefuseDraft[medId]) state.medRefuseDraft[medId] = { refused:false, reason:"" };
  state.medRefuseDraft[medId].refused = !state.medRefuseDraft[medId].refused;
  scheduleRender();
}
function medRefuseChoicePanel(residentId, anchor, meds){
  const rows = meds.map(med=>{
    const d = state.medRefuseDraft[med.id] || { refused:false, reason:"" };
    const doseLabel = med.dosage ? ` — ${esc(med.dosage)}` : "";
    return `<div class="med-log-row">
      <div class="med-log-name">${esc(med.name)}${doseLabel}</div>
      <button type="button" class="task-log-opt ${d.refused?'refuse active':''}" style="min-height:40px; flex:none; min-width:120px;" onclick="toggleMedRefuseDraft(${med.id})">${d.refused ? "✕ Refused" : "Mark as refused"}</button>
      ${d.refused ? `<div class="dc-inline-input"><input type="text" id="medrefuse-reason-${med.id}-${anchor}" placeholder="Reason for refusal" value="${esc(d.reason)}" onchange="updateMedRefuseDraftReason(${med.id},'${anchor}')"></div>` : ""}
    </div>`;
  }).join("");
  return `<div class="card routine-quicklog" onclick="event.stopPropagation()">
    <div class="dc-label">Choose which were refused — everyone else here is marked Passed</div>
    ${rows}
    <div class="routine-quicklog-actions">
      <button class="btn primary small" onclick="saveRefuseChoice('${residentId}','${anchor}')">Save to Daily Care</button>
      <button class="btn small" onclick="cancelRefuseChoice()">Cancel</button>
    </div>
  </div>`;
}
function updateMedRefuseDraftReason(medId, anchor){
  const el = document.getElementById(`medrefuse-reason-${medId}-${anchor}`);
  if(!el || !state.medRefuseDraft[medId]) return;
  state.medRefuseDraft[medId].reason = el.value;
}
function cancelRefuseChoice(){
  state.medChoosingRefuse = false;
  state.medRefuseDraft = {};
  scheduleRender();
}
function saveRefuseChoice(residentId, anchor){
  const meds = allDueMedsForAnchor(residentId, anchor);
  meds.forEach(med=>{
    const d = state.medRefuseDraft[med.id] || { refused:false, reason:"" };
    if(d.refused){
      const el = document.getElementById(`medrefuse-reason-${med.id}-${anchor}`);
      setMedStatus(residentId, med.id, anchor, "refuse", el ? el.value.trim() : d.reason);
    } else {
      setMedStatus(residentId, med.id, anchor, "pass", "");
    }
  });
  state.expandedMedLogKey = null;
  state.medChoosingRefuse = false;
  state.medRefuseDraft = {};
  scheduleRender();
}
// Standalone Today's Flow row for a resident's "Other"-time medication(s) — same shape as a Scheduled
