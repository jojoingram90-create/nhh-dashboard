// The shared card wrapper every fillable section on the resident profile now uses.
//   residentId, sectionKey — identify this section for edit/save/print state.
//   label    — section heading, also the print title and the "+ Complete X" prompt text.
//   editHtml — markup shown while editing.
//   readHtml — markup shown once filled in and not editing.
//   hint     — optional small caption shown under either state.
//   isEmpty  — true if nothing's been entered yet (drives the "+ Complete X" prompt).
function profileSection(residentId, sectionKey, label, editHtml, readHtml, hint, isEmpty){
  const canEdit = moduleEdit('residents');
  const editing = canEdit && isSectionEditing(residentId, sectionKey);
  const justSaved = !!(state.sectionSaveFlash[residentId] && state.sectionSaveFlash[residentId][sectionKey]);
  sectionPrintRegistry[residentId+"|"+sectionKey] = { label, html: isEmpty ? "<span class='tag'>Not yet completed</span>" : readHtml };

  if(!editing && isEmpty){
    return `<div class="cp-section cp-section-empty">
      ${canEdit
        ? `<button type="button" class="cp-complete-btn" onclick="openSectionEdit('${residentId}','${sectionKey}')">+ Complete ${esc(label)}</button>`
        : `<span class="dc-label">${esc(label)}</span><div class="cp-hint" style="margin-top:6px;">Not yet completed.</div>`}
    </div>`;
  }

  const controls = editing
    ? `<button class="btn small primary" onclick="saveSectionEdit('${residentId}','${sectionKey}')">💾 Save</button>`
    : `${justSaved ? badge("good","✓ Saved") : ""}
       ${canEdit ? `<button class="btn small" onclick="openSectionEdit('${residentId}','${sectionKey}')">✎ Edit</button>` : ""}
       <button class="btn small" onclick="printRegisteredSection('${residentId}','${sectionKey}')">🖨 Print</button>`;

  return `<div class="cp-section">
    <div class="cp-section-head">
      <span class="dc-label">${esc(label)}</span>
      <div class="cp-section-actions">${controls}</div>
    </div>
    ${editing ? editHtml : readHtml}
    ${hint ? `<div class="cp-hint">${hint}</div>` : ""}
  </div>`;
}

/* ---------------- Master Settings (Leadership only) — customizable Care Plan option lists ----------
   Lets Leadership add new chip/tag options to the lists used throughout every resident's Care Plan
   (Diagnosis, Mobility, Transfers, Toileting, Communication, Diet, Wearables) without editing code —
   e.g. adding "Parkinson's" as a Diagnosis option, or a new Mobility level. Every resident's Care Plan
   picks up a new option immediately since these are shared, global lists. */
const MASTER_SETTINGS_LISTS = [
  { key:"diagnosis",     label:"Diagnosis options",      get:()=>DIAGNOSIS_TAGS, set:(arr)=>{ DIAGNOSIS_TAGS = arr; } },
  { key:"mobility",      label:"Mobility options",       get:()=>MOBILITY_TYPES, set:(arr)=>{ MOBILITY_TYPES = arr; } },
  { key:"transfer",      label:"Transfer options",       get:()=>TRANSFER_TYPES, set:(arr)=>{ TRANSFER_TYPES = arr; } },
  { key:"toileting",     label:"Toileting options",      get:()=>TOILETING_TYPES, set:(arr)=>{ TOILETING_TYPES = arr; } },
  { key:"communication", label:"Communication options",  get:()=>COMM_TYPES, set:(arr)=>{ COMM_TYPES = arr; } },
  { key:"diet",          label:"Diet tags",              get:()=>DIET_TAGS, set:(arr)=>{ DIET_TAGS = arr; } },
  { key:"wearables",     label:"Wearable tags",          get:()=>WEARABLE_TAGS, set:(arr)=>{ WEARABLE_TAGS = arr; } }
];
function openMasterSettings(){
  if(!isSystemAdmin()) return;
  state.masterSettingsOpen = true;
  state.masterSettingsCategory = MASTER_SETTINGS_LISTS[0].key;
  scheduleRender();
}
function closeMasterSettings(){
  state.masterSettingsOpen = false;
  scheduleRender();
}
function setMasterSettingsCategory(key){
  state.masterSettingsCategory = key;
  scheduleRender();
}
function masterSettingsAddOption(key){
  if(!isSystemAdmin()) return;
  const cfg = MASTER_SETTINGS_LISTS.find(c=>c.key===key);
  if(!cfg) return;
  const el = document.getElementById("masterSettingsNewOption-"+key);
  const val = (el ? el.value : "").trim();
  if(!val) return;
  const list = cfg.get();
  if(!list.some(o=>o.toLowerCase()===val.toLowerCase())) list.push(val);
  if(el) el.value = "";
  scheduleRender();
}
function masterSettingsRemoveOption(key, value){
  if(!isSystemAdmin()) return;
  const cfg = MASTER_SETTINGS_LISTS.find(c=>c.key===key);
  if(!cfg) return;
  const list = cfg.get();
  const idx = list.indexOf(value);
  if(idx>=0) list.splice(idx,1);
  scheduleRender();
}
function renderMasterSettingsModal(){
  const activeKey = state.masterSettingsCategory || MASTER_SETTINGS_LISTS[0].key;
  const cfg = MASTER_SETTINGS_LISTS.find(c=>c.key===activeKey) || MASTER_SETTINGS_LISTS[0];
  const options = cfg.get();
  return `
  <div class="modal-overlay">
    <div class="modal-card" style="width:min(640px,100%);">
      <div class="modal-head">
        <div><h2>Master Settings — Care Plan Options</h2><span class="hint">Leadership only. Adding an option here makes it available on every resident's Care Plan immediately.</span></div>
        <button class="btn small" onclick="closeMasterSettings()">✕ Close</button>
      </div>
      <div class="chip-row" style="padding:0 20px; margin-top:4px;">
        ${MASTER_SETTINGS_LISTS.map(c=>`<button type="button" class="chip-btn ${c.key===activeKey?'active':''}" onclick="setMasterSettingsCategory('${c.key}')">${c.label}</button>`).join("")}
      </div>
      <div style="padding:16px 20px;">
        <div class="tag-list" style="margin-bottom:14px;">
          ${options.length ? options.map(o=>`<span class="tag">${esc(o)}<button type="button" class="tag-remove" onclick="masterSettingsRemoveOption('${cfg.key}','${o.replace(/'/g,"\\'")}')">✕</button></span>`).join("") : "<span class='tag'>No options yet</span>"}
        </div>
        <div class="dc-inline-input" style="display:flex; gap:8px;">
          <input type="text" id="masterSettingsNewOption-${cfg.key}" placeholder="Add a new option" style="flex:1;" onkeydown="if(event.key==='Enter'){event.preventDefault(); masterSettingsAddOption('${cfg.key}');}">
          <button class="btn small primary" onclick="masterSettingsAddOption('${cfg.key}')">Add</button>
        </div>
      </div>
    </div>
  </div>`;
}

function renderCarePlanBody(r){
  const cp = carePlans[r.id];
