// Daily Care Log — Medications section. Imports every medication straight from the resident's Care
// Plan (no separate data entry here) and lists one Pass/Refuse row per scheduled time, reading/writing
// the exact same dc.medications record the Today's Flow "Log Meds" quick-log uses — so a dose logged
// from either screen shows up on both immediately.
function medicationsDCBlock(r){
  const cp = carePlans[r.id];
  const meds = cp.medications || [];
  if(!meds.length) return `<div class="cp-hint">No medications on file. Add medications on the resident's Medications tab.</div>`;
  const dc = getDC(r.id);
  return meds.map(med=>{
    const anchors = medAnchorsForMed(med);
    if(!anchors.length) return `<div class="dc-field"><span class="dc-label">${esc(med.name)}${med.dosage?` — ${esc(med.dosage)}`:""}</span><div class="cp-hint">No administration time set yet — add one on the Medications tab.</div></div>`;
    return `<div class="dc-field">
      <span class="dc-label" style="margin-bottom:10px;">${esc(med.name)}${med.dosage?` — ${esc(med.dosage)}`:""}</span>
      ${anchors.map(a=>{
        const key = medLogKey(med.id, a.anchor);
        const rec = dc.medications[key];
        const status = rec ? rec.status : null;
        return `<div style="margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid var(--border);">
          <div class="dc-inline-input" style="margin-top:0; display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;">
            <span class="tag">${a.label}</span>
            <div class="chip-row">
              <button type="button" class="chip-btn ${status==='pass'?'active':''}" onclick="setMedStatusFromLog('${r.id}',${med.id},'${a.anchor}','pass')">Pass</button>
              <button type="button" class="chip-btn ${status==='refuse'?'active':''}" onclick="setMedStatusFromLog('${r.id}',${med.id},'${a.anchor}','refuse')">Refuse</button>
            </div>
          </div>
          ${status==='refuse' ? `<div class="dc-inline-input"><input type="text" id="dc-medRefReason-${med.id}-${a.anchor}-${r.id}" placeholder="Reason for refusal" value="${esc(rec.reason)}" onchange="updateMedRefuseReason('${r.id}',${med.id},'${a.anchor}')"></div>` : ""}
          ${rec ? `<div class="dc-inline-input"><span class="dc-stamp">${esc(rec.by)} · ${esc(rec.at)}</span></div>` : ""}
          ${rec && rec.corrections && rec.corrections.length ? `<div class="dc-inline-input"><span class="dc-stamp" title="${esc(rec.corrections.map(c=>`was ${c.status}${c.reason?` (${c.reason})`:""} — ${c.by} · ${c.at}`).join('; '))}">✎ Corrected — was ${esc(rec.corrections[rec.corrections.length-1].status)} · ${esc(rec.corrections[rec.corrections.length-1].by)} · ${esc(rec.corrections[rec.corrections.length-1].at)}${rec.corrections.length>1 ? ` (+${rec.corrections.length-1} earlier)` : ""}</span></div>` : ""}
        </div>`;
      }).join("")}
    </div>`;
  }).join("");
}
function setMedStatusFromLog(residentId, medId, anchor, status){
  const dc = getDC(residentId);
  const key = medLogKey(medId, anchor);
  const existingReason = (dc.medications[key] && dc.medications[key].reason) || "";
  setMedStatus(residentId, medId, anchor, status, status==="refuse" ? existingReason : "");
  scheduleRender();
}
function updateMedRefuseReason(residentId, medId, anchor){
  const el = document.getElementById(`dc-medRefReason-${medId}-${anchor}-${residentId}`);
  if(!el) return;
  const dc = getDC(residentId);
  const key = medLogKey(medId, anchor);
  if(!dc.medications[key]) return;
  dc.medications[key].reason = el.value;
  touchSection(dc, "medications", currentUser());
}

function renderDailyCareDetail(){
  const r = residents.find(x=>x.id===state.dcResidentId);
  const viewDate = state.dcViewDate || todayIso();
  const isToday = viewDate === todayIso();
  const dc = getDC(r.id, viewDate);
  const id = currentUser();
  const canSignOff = id.shift === "Day" && isToday;

  // Medication administration used to be asked again here, per meal — removed since Section 3
  // (Medications) already covers every scheduled medication precisely, per dose, and this was just
  // a duplicate, less-precise version of the same question.
  const mealBlock = (mealKey,label) => {
    const m = dc.meals[mealKey];
    return `<div class="dc-field">
      <div class="dc-meal-head"><span class="dc-label" style="margin-bottom:0;">${label} — % eaten</span>${dcStamp(dc,mealKey)}</div>
      ${chipRow(r.id, `meals.${mealKey}.pct`, MEAL_PCT, m.pct)}
    </div>`;
  };

  const VITAL_FIELD_ID = { temperature:"vitalTemp", pulse:"vitalPulse", respirations:"vitalResp", o2sat:"vitalO2" };
  const vitalRow = (vt) => {
    const checked = !!dc.vitals.types[vt.key];
    let inputs = "";
    if(checked){
      const t = `onchange="dcTouchField('${r.id}','vitals')"`;
      if(vt.key==="bp") inputs = `<input type="text" id="dc-vitalBPsys-${r.id}" placeholder="Sys" value="${esc(dc.vitals.types.bp.sys)}" style="width:60px;" ${t}> / <input type="text" id="dc-vitalBPdia-${r.id}" placeholder="Dia" value="${esc(dc.vitals.types.bp.dia)}" style="width:60px;" ${t}>`;
      else if(vt.key==="pain") inputs = `<input type="text" id="dc-vitalPainRating-${r.id}" placeholder="Rating /10" value="${esc(dc.vitals.types.pain.rating)}" style="width:80px;" ${t}> <input type="text" id="dc-vitalPainLocation-${r.id}" placeholder="Location" value="${esc(dc.vitals.types.pain.location)}" style="width:110px;" ${t}> <input type="text" id="dc-vitalPainDesc-${r.id}" placeholder="Description" value="${esc(dc.vitals.types.pain.description)}" style="width:130px;" ${t}>`;
