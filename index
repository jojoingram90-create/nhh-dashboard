// "Meals" folds in Food Menu + Food Photos, "Admin" folds in Pending Approvals + Manage Staff. Each
// item still routes to exactly the same view it always did; only where it shows up in the sidebar
// changes. See groupNavItems()/renderSidebar().
const NAV_GROUP_OF = { menu:"meals", foodphotos:"meals", approvals:"admin", staff:"admin", houses:"admin" };
const NAV_GROUP_META = { meals:{label:"Meals", icon:"▤"}, admin:{label:"Admin", icon:"⚙"} };
function groupNavItems(items){
  const groups = {};
  const out = [];
  items.forEach(item=>{
    const groupId = NAV_GROUP_OF[item.id];
    if(!groupId){ out.push(item); return; }
    let g = groups[groupId];
    if(!g){
      const meta = NAV_GROUP_META[groupId];
      g = { id:groupId, label:meta.label, icon:meta.icon, isGroup:true, children:[] };
      groups[groupId] = g;
      out.push(g);
    }
    g.children.push(item);
  });
  return out;
}

