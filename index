/* ---------------- Module permissions (Manage Staff) ---------------- */
// Each nav module gets its own view/edit permission per staff member, rather than the single blanket
// manager-or-leadership canEdit() check above. A staff member normally has no explicit `permissions`
// object at all — they simply inherit the role-based default below, which reproduces the exact
// behavior canEdit() always had (manager/leadership = edit everywhere, caregiver = view everywhere).
// An explicit `permissions` object only appears once an admin adds a new staff member or edits an
// existing one on the Manage Staff screen, and from then on it's an independent per-module override
// for that one person — it never affects anyone else's defaults.
const MODULES = [
  {key:"dashboard", label:"Dashboard"},
  {key:"residents", label:"Residents & Care Plans"},
  {key:"dailycare", label:"Daily Care Log"},
  {key:"incidents", label:"Incident Reports"},
  {key:"calendar", label:"Calendar"},
  {key:"menu", label:"Food Menu"},
  {key:"showers", label:"Shower Schedule"},
  {key:"supplies", label:"Supplies Received"},
  {key:"foodphotos", label:"Food Photo QC"},
  {key:"directory", label:"Directory"}
];
function defaultPermissionsForRole(role){
  const tier = (role==="manager" || role==="leadership") ? "edit" : "view";
  const perms = {};
  MODULES.forEach(m=>{ perms[m.key] = tier; });
  return perms;
}
function staffPermissions(staff){ return staff.permissions || defaultPermissionsForRole(staff.role); }
function moduleAccess(key){
  const u = currentUser();
  if(!u) return "none";
  return staffPermissions(u)[key] || "view";
}
function moduleView(key){ return moduleAccess(key) !== "none"; }
function moduleEdit(key){ return moduleAccess(key) === "edit"; }
// "Admin" (can add/remove staff, assign PINs and module permissions) is the leadership role itself,
// not a separate hand-maintained name list like MENU_ADMINS — so a newly added leadership account is
// automatically an admin too, without editing code. Deliberately NOT part of the configurable
// permissions matrix above: letting module permissions grant staff-management access would let someone
// hand themselves admin rights through the very screen meant to be admin-only.
function isSystemAdmin(){ const u = currentUser(); return !!u && u.role === "leadership"; }
// Guards direct navigation (not just what the nav sidebar shows) into a module a staff member's
// permissions don't allow — render() bounces back to the dashboard rather than rendering a screen
// someone tapped their way into before a permission changed, or via a stray deep link.
function canAccessView(view){
  if(view==="approvals") return moduleEdit("menu") || moduleEdit("residents");
  if(view==="staff") return isSystemAdmin();
  if(view==="houses") return isSystemAdmin();
  if(view==="manageresidents") return moduleEdit("residents");
  if(view==="resident") return moduleView("residents");
  if(view==="dailycaredetail") return moduleView("dailycare");
  if(view==="incidentdetail") return moduleView("incidents");
  if(MODULES.some(m=>m.key===view)) return moduleView(view);
  return true;
}

