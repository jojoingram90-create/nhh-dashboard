<title>NHH House Dashboard</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap">
<style>
  :root{
    --bg:#F3F6FA; --surface:#FFFFFF; --surface-alt:#EAEFF6; --border:#D7DFEA;
    --text:#1A2433; --text-muted:#5C6B7D; --text-faint:#8695A8;
    --accent:#1F3F66; --accent-strong:#142C47; --accent-soft:#DEE8F4; --accent-soft-text:#1F3F66;
    --shadow: 0 1px 2px rgba(20,32,52,.06), 0 6px 20px rgba(20,32,52,.06);

    --fall-bg:#FCEEDC; --fall-text:#8A4B08; --fall-dot:#C77A1F;
    --hospice-bg:#F0E6F8; --hospice-text:#5B3B87; --hospice-dot:#7C57A8;
    --away-bg:#E1EDF8; --away-text:#1F5788; --away-dot:#3E7CB1;
    --alert-bg:#FBE3E1; --alert-text:#9A2C22; --alert-dot:#C0392B;
    --good-bg:#E1F2E8; --good-text:#256A44; --good-dot:#2E7D57;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#0F1620; --surface:#161F2C; --surface-alt:#1D2836; --border:#2B3A4C;
      --text:#E7ECF3; --text-muted:#9AACC2; --text-faint:#71839A;
      --accent:#8FB4E3; --accent-strong:#BFD6F0; --accent-soft:#1E3350; --accent-soft-text:#BFD6F0;
      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.35);

      --fall-bg:#3A2A12; --fall-text:#F0B266; --fall-dot:#E0954A;
      --hospice-bg:#2C2340; --hospice-text:#D2B9F0; --hospice-dot:#A57FD6;
      --away-bg:#152B40; --away-text:#9CC6EE; --away-dot:#5B9AD1;
      --alert-bg:#3A1D1A; --alert-text:#F2A79E; --alert-dot:#D9584B;
      --good-bg:#16301F; --good-text:#8FD3AA; --good-dot:#49A06E;
    }
  }
  :root[data-theme="dark"]{
    --bg:#0F1620; --surface:#161F2C; --surface-alt:#1D2836; --border:#2B3A4C;
    --text:#E7ECF3; --text-muted:#9AACC2; --text-faint:#71839A;
    --accent:#8FB4E3; --accent-strong:#BFD6F0; --accent-soft:#1E3350; --accent-soft-text:#BFD6F0;
    --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.35);
    --fall-bg:#3A2A12; --fall-text:#F0B266; --fall-dot:#E0954A;
    --hospice-bg:#2C2340; --hospice-text:#D2B9F0; --hospice-dot:#A57FD6;
    --away-bg:#152B40; --away-text:#9CC6EE; --away-dot:#5B9AD1;
    --alert-bg:#3A1D1A; --alert-text:#F2A79E; --alert-dot:#D9584B;
    --good-bg:#16301F; --good-text:#8FD3AA; --good-dot:#49A06E;
  }

  *{box-sizing:border-box;}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:"Public Sans", -apple-system, "Segoe UI", sans-serif;
    font-size:14px; line-height:1.5;
  }
  h1,h2,h3,h4{ margin:0; text-wrap:balance; font-weight:700; letter-spacing:-.01em; }
  button{ font-family:inherit; font-size:inherit; cursor:pointer; }
  table{ border-collapse:collapse; width:100%; }
  .tabular{ font-variant-numeric:tabular-nums; }

  #app{ display:flex; min-height:100vh; visibility:hidden; }

  /* ---------- Sidebar ---------- */
  #sidebar{
    width:228px; flex:none; background:var(--surface); border-right:1px solid var(--border);
    display:flex; flex-direction:column; padding:20px 14px; gap:22px;
  }
  .brand{ display:flex; align-items:center; gap:10px; padding:0 6px; }
  .brand-mark{
    width:34px; height:34px; border-radius:9px; background:var(--accent); color:#fff;
    display:flex; align-items:center; justify-content:center; font-weight:800; font-size:15px; flex:none;
  }
  .brand-text{ line-height:1.2; }
  .brand-text .top{ font-weight:800; font-size:14.5px; }
  .brand-text .sub{ font-size:12.5px; color:var(--text-muted); }

  .house-picker{ position:relative; }
  .house-picker select{
    width:100%; appearance:none; background:var(--surface-alt); border:1px solid var(--border);
    color:var(--text); border-radius:8px; padding:9px 30px 9px 11px; font-weight:600; font-size:13.5px;
  }
  .house-picker::after{
    content:"⌄"; position:absolute; right:11px; top:50%; transform:translateY(-55%);
    color:var(--text-muted); pointer-events:none; font-size:14px;
  }
  .house-picker.locked select{ opacity:.75; cursor:not-allowed; }

  nav.primary{ display:flex; flex-direction:column; gap:2px; }
  .nav-item{
    display:flex; align-items:center; gap:10px; padding:12px 11px; border-radius:8px;
    color:var(--text-muted); background:none; border:none; text-align:left; width:100%; font-weight:600; font-size:14px;
  }
  .nav-item .ic{ width:18px; text-align:center; font-size:14px; }
  .nav-item:hover{ background:var(--surface-alt); color:var(--text); }
  .nav-item.active{ background:var(--accent-soft); color:var(--accent-soft-text); }
  .nav-badge{ margin-left:auto; background:var(--accent); color:#fff; border-radius:99px; padding:1px 8px; font-size:11.5px; font-weight:700; min-width:18px; text-align:center; }

  /* Expandable nav sections (Meals, Admin) — a group header that reveals its own unchanged pages
     underneath, rather than merging them into one page. See visibleNavItems()/renderSidebar(). */
  .nav-group.active .nav-group-toggle{ color:var(--text); }
  .nav-group-caret{ font-size:11px; color:var(--text-faint); margin-left:auto; }
  .nav-group-toggle .nav-badge{ margin-left:6px; }
  .nav-group-children{ display:flex; flex-direction:column; gap:2px; margin:2px 0 4px; }
  .nav-subitem{ padding-left:30px; font-size:13.5px; }

  .sidebar-foot{ margin-top:auto; padding:10px 6px 0; border-top:1px solid var(--border); font-size:12.5px; color:var(--text-faint); }

  button.sidebar-toggle{ display:none; }
  .sidebar-backdrop{ display:none; }

  @media (max-width: 900px){
    button.sidebar-toggle{ display:inline-flex; }
    #sidebar{
      position:fixed; top:0; left:0; height:100vh; z-index:60; box-shadow:0 0 0 100vw rgba(0,0,0,0), var(--shadow);
      transform:translateX(-100%); transition:transform .25s ease; width:250px;
    }
    #app.sidebar-open #sidebar{ transform:translateX(0); }
    .sidebar-backdrop{
      display:none; position:fixed; inset:0; background:rgba(20,20,20,.4); z-index:55;
    }
    #app.sidebar-open .sidebar-backdrop{ display:block; }
  }

  /* ---------- Main ---------- */
  #main{ flex:1; min-width:0; display:flex; flex-direction:column; }
  #topbar{
    display:flex; align-items:center; justify-content:space-between; gap:16px;
    padding:14px 26px; border-bottom:1px solid var(--border); background:var(--surface);
    position:sticky; top:0; z-index:5;
  }
  #topbar h1{ font-size:19px; }
  .topbar-date{ color:var(--text-muted); font-size:13px; font-weight:600; }
  .topbar-right{ display:flex; align-items:center; gap:10px; }
  .identity-chip{ display:flex; align-items:center; gap:8px; background:var(--surface-alt); border:1px solid var(--border); border-radius:99px; padding:6px 13px 6px 9px; font-size:13px; font-weight:700; line-height:1.3; }
  .identity-dot{ width:9px; height:9px; border-radius:99px; flex:none; }
  .identity-role{ display:block; font-size:12px; font-weight:600; color:var(--text-faint); }

  /* PIN lock screen */
  .lock-screen{ position:fixed; inset:0; z-index:1000; display:none; align-items:center; justify-content:center; background:var(--bg); }
  .lock-card{ width:min(360px, 90vw); background:var(--surface); border:1px solid var(--border); border-radius:16px; box-shadow:var(--shadow); padding:32px 28px; text-align:center; }
  .lock-title{ font-size:15px; font-weight:700; margin:20px 0 18px; }
  .pin-dots{ display:flex; justify-content:center; gap:14px; margin-bottom:26px; }
  .pin-dot{ width:14px; height:14px; border-radius:99px; border:2px solid var(--border); background:transparent; }
  .pin-dot.filled{ background:var(--accent); border-color:var(--accent); }
  .pin-dot.error{ background:var(--alert-dot); border-color:var(--alert-dot); }
  .pin-pad{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:22px; }
  .pin-key{ padding:16px 0; border-radius:12px; border:1px solid var(--border); background:var(--surface-alt); color:var(--text); font-size:19px; font-weight:700; font-family:inherit; }
  .pin-key:hover{ border-color:var(--accent); }
  .pin-key-del{ font-size:14px; color:var(--text-muted); }
  .lock-hint{ font-size:12px; color:var(--text-faint); line-height:1.5; margin-bottom:12px; }

  #content{ padding:22px 26px 60px; max-width:1180px; }

  /* ---------- Shared bits ---------- */
  .section{ margin-bottom:30px; }
  .section-head{ display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:12px; }
  .section-head h2{ font-size:15px; }
  .section-head .hint{ font-size:13px; color:var(--text-faint); }

  .card{ background:var(--surface); border:1px solid var(--border); border-radius:12px; box-shadow:var(--shadow); }
  .btn{
    border:1px solid var(--border); background:var(--surface); color:var(--text);
    padding:10px 15px; border-radius:8px; font-weight:600; font-size:13px; display:inline-flex; align-items:center; gap:6px; min-height:40px;
  }
  .btn:hover{ background:var(--surface-alt); }
  .btn.primary{ background:var(--accent); border-color:var(--accent); color:#fff; }
  .btn.primary:hover{ background:var(--accent-strong); }
  .btn.small{ padding:8px 13px; font-size:12.5px; min-height:34px; }
  .btn[disabled]{ opacity:.45; cursor:not-allowed; }

  /* Big, one-tap logging buttons for Today's Flow — Meals Eaten / Log Vitals / Medications. Replaces
     a small text button + separate checkbox with one clear, easy-to-hit action; see task-log-options
     for the icon-button row a tap opens (% eaten, or Pass/Refuse). */
  .task-log-btn{ padding:12px 18px; border-radius:10px; font-weight:700; font-size:14px; min-height:48px; }
  .task-log-options{ display:flex; flex-wrap:wrap; gap:10px; margin-top:10px; }
  .task-log-opt{ border:1px solid var(--border); background:var(--surface-alt); color:var(--text); padding:14px 10px; border-radius:10px; font-weight:700; font-size:14px; min-width:64px; min-height:52px; flex:1 1 64px; text-align:center; }
  .task-log-opt.active{ background:var(--accent); border-color:var(--accent); color:#fff; }
  .task-log-opt.pass{ background:var(--good-bg); border-color:var(--good-dot); color:var(--good-text); }
  .task-log-opt.pass.active{ background:var(--good-dot); color:#fff; }
  .task-log-opt.refuse{ background:var(--alert-bg); border-color:var(--alert-dot); color:var(--alert-text); }
  .task-log-opt.refuse.active{ background:var(--alert-dot); color:#fff; }

  .badge{ display:inline-flex; align-items:center; gap:5px; padding:3px 9px 3px 7px; border-radius:99px; font-size:12px; font-weight:700; white-space:nowrap; }
  .badge .dot{ width:6px; height:6px; border-radius:99px; }
  .badge.fall{ background:var(--fall-bg); color:var(--fall-text); } .badge.fall .dot{ background:var(--fall-dot); }
  .badge.hospice{ background:var(--hospice-bg); color:var(--hospice-text); } .badge.hospice .dot{ background:var(--hospice-dot); }
  .badge.away{ background:var(--away-bg); color:var(--away-text); } .badge.away .dot{ background:var(--away-dot); }
  .badge.alert{ background:var(--alert-bg); color:var(--alert-text); } .badge.alert .dot{ background:var(--alert-dot); }
  .badge.good{ background:var(--good-bg); color:var(--good-text); } .badge.good .dot{ background:var(--good-dot); }

  /* stat strip */
  .stat-strip{ display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
  .stat-tile{ padding:14px 16px; transition:box-shadow .15s ease, transform .15s ease; }
  .stat-tile:hover{ box-shadow:0 4px 14px rgba(0,0,0,.08); transform:translateY(-1px); }
  .stat-tile .n{ font-size:24px; font-weight:800; font-variant-numeric:tabular-nums; }
  .stat-tile .l{ font-size:13px; color:var(--text-muted); font-weight:600; margin-top:2px; }
  @keyframes statListIn{ from{ opacity:0; transform:translateY(-6px); } to{ opacity:1; transform:translateY(0); } }
  .stat-detail-list{ margin-top:12px; animation:statListIn .18s ease-out; }

  /* resident grid */
  .resident-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(215px,1fr)); gap:12px; }
  .resident-card{ padding:14px; text-align:left; display:flex; flex-direction:column; gap:9px; }
  .resident-card:hover{ border-color:var(--accent); cursor:pointer; }
  .r-top{ display:flex; align-items:center; gap:10px; }
  .avatar{
    width:38px; height:38px; border-radius:99px; background:var(--accent-soft); color:var(--accent-soft-text);
    display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13.5px; flex:none;
  }
  .r-name{ font-weight:700; font-size:14px; }
  .r-room{ font-size:12.5px; color:var(--text-muted); }
  .r-badges{ display:flex; flex-wrap:wrap; gap:5px; }
  .r-note{ font-size:12.5px; color:var(--text-muted); border-top:1px solid var(--border); padding-top:8px; }

  /* today's flow */
  .flow-block{ padding:16px 18px; margin-bottom:12px; }
  .flow-head{ display:flex; align-items:center; justify-content:center; margin-bottom:14px; }
  .flow-head h3{ font-size:21px; font-weight:800; letter-spacing:.01em; }
  .flow-head .shift-tag{ font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:var(--text-faint); background:var(--surface-alt); padding:3px 8px; border-radius:99px; }

  /* time-of-day buckets — collapsed by default except the one matching the current time */
  .flow-bucket{ border-top:1px solid var(--border); }
  .flow-bucket:first-child{ border-top:none; }
  .flow-bucket-toggle{
    display:flex; align-items:center; gap:9px; width:100%; text-align:left; background:none; border:none;
    padding:12px 4px; font-family:inherit; cursor:pointer; color:var(--text);
  }
  .flow-bucket-caret{ font-size:12px; color:var(--text-faint); width:12px; flex:none; }
  .flow-bucket-label{ font-size:13.5px; font-weight:700; }
  .flow-bucket-now-pill{ font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#fff; background:var(--accent); padding:2px 8px; border-radius:99px; }
  .flow-bucket-count{ margin-left:auto; font-size:12.5px; color:var(--text-faint); font-weight:600; }
  .flow-bucket-body{ padding-bottom:6px; }

  .task-row{ display:flex; align-items:flex-start; gap:9px; padding:8px 6px 8px 9px; border-top:1px solid var(--border); border-left:3px solid transparent; }
  .task-row:first-of-type{ border-top:none; }
  .flow-now-marker + .task-row, .mealgroup-members .task-row:first-child{ border-top:none; }
  .task-row[data-type="wake"]{ border-left-color:var(--fall-dot); }
  .task-row[data-type="shower"]{ border-left-color:var(--away-dot); }
  .task-row[data-type="breakfast"], .task-row[data-type="lunch"], .task-row[data-type="dinner"]{ border-left-color:var(--good-dot); }
  .task-row[data-type="routine"]{ border-left-color:var(--hospice-dot); }
  .task-row[data-type="bedtime"]{ border-left-color:var(--accent); }
  .task-row.flow-row-current{ background:var(--accent-soft); border-radius:8px; }
  .flow-now-marker{ display:flex; align-items:center; gap:8px; margin:8px 0; font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--accent); }
  .flow-now-marker::before, .flow-now-marker::after{ content:""; flex:1; height:1px; background:var(--accent); opacity:.35; }
  .flow-completed-toggle{ cursor:pointer; font-size:13px; font-weight:700; color:var(--text-muted); padding:11px 2px 7px; margin-top:6px; border-top:1px solid var(--border); user-select:none; }
  .flow-completed-toggle:hover{ color:var(--text); }
  .task-row input[type=checkbox]{ width:22px; height:22px; accent-color:var(--accent); flex:none; margin-top:2px; }
  .task-row-headline{ display:flex; flex-direction:column; gap:4px; flex:1; min-width:0; }
  .task-row .who{ font-weight:700; font-size:13.5px; display:flex; align-items:center; flex-wrap:wrap; gap:2px; }
  .task-row-desc{ display:flex; align-items:flex-start; gap:6px; color:var(--text-muted); font-size:13px; flex-wrap:wrap; }
  .desc-text{ flex:1; min-width:0; }
  .show-more-btn{ background:none; border:none; color:var(--accent); font-weight:700; font-size:12.5px; padding:0; cursor:pointer; font-family:inherit; white-space:nowrap; }
  .show-more-btn:hover{ text-decoration:underline; }
  .task-row-actions{ display:flex; align-items:center; gap:8px; flex:none; margin-left:auto; padding-top:1px; }
  .task-row .staff{ font-size:12.5px; color:var(--good-text); font-weight:600; white-space:nowrap; }
  .task-row .added-by{ font-size:12.5px; color:var(--text-faint); white-space:nowrap; }
  .task-row.done .who, .task-row.done .task-row-desc{ text-decoration:line-through; opacity:.5; }
  .dc-stamp-editable{ display:flex; align-items:center; gap:6px; }

  /* meal groups — residents sharing a standard mealtime nest under one collapsible row */
  .mealgroup-row{ cursor:pointer; }
  .mealgroup-row:hover{ background:var(--surface-alt); border-radius:8px; }
  .mealgroup-caret{ font-size:12px; color:var(--text-faint); padding-top:3px; flex:none; }
  .mealgroup-count-pill{ font-size:12px; font-weight:700; color:var(--text-faint); white-space:nowrap; }
  .mealgroup-members{ padding-left:27px; }
  .custom-time-badge{ display:inline-flex; align-items:center; gap:3px; font-size:11px; font-weight:700; background:var(--accent-soft); color:var(--accent-soft-text); padding:2px 8px; border-radius:99px; white-space:nowrap; }

  /* resident profile */
  .profile-head{ display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:18px; }
  .profile-id{ display:flex; gap:14px; align-items:center; }
  .avatar.lg{ width:58px; height:58px; font-size:19px; }
  .profile-id h2{ font-family:"Source Serif 4", Georgia, serif; font-size:23px; font-weight:600; }
  .profile-meta{ font-size:13px; color:var(--text-muted); margin-top:3px; }
  .back-link{ background:none; border:none; color:var(--text-muted); font-weight:600; font-size:13px; padding:0 0 10px; }
  .back-link:hover{ color:var(--accent); }

  .tabs{ display:flex; gap:2px; border-bottom:1px solid var(--border); margin-bottom:16px; }
  .tab{ background:none; border:none; padding:10px 14px; font-weight:600; font-size:13px; color:var(--text-muted); border-bottom:2px solid transparent; margin-bottom:-1px; }
  .tab.active{ color:var(--accent); border-color:var(--accent); }

  .kv-grid{ display:grid; grid-template-columns:170px 1fr; gap:11px 16px; }
  .kv-grid dt{ font-size:12.5px; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:var(--text-faint); }
  .kv-grid dd{ margin:0; font-size:14px; }
  .tag-list{ display:flex; flex-wrap:wrap; gap:6px; }
  .tag{ background:var(--surface-alt); border:1px solid var(--border); border-radius:99px; padding:3px 10px; font-size:12.5px; font-weight:600; display:inline-flex; align-items:center; gap:6px; }
  .tag-remove{ background:none; border:none; color:inherit; opacity:.55; cursor:pointer; font-size:12px; padding:6px; margin:-6px; font-family:inherit; line-height:1; }
  .tag-remove:hover{ opacity:1; }
  .tag.perm-tag-none{ color:var(--text-faint); background:transparent; border-style:dashed; }
  .cp-section{ padding-bottom:14px; margin-bottom:14px; border-bottom:1px solid var(--border); }
  .cp-section:last-child{ border-bottom:none; margin-bottom:0; padding-bottom:0; }
  .cp-hint{ font-size:12.5px; color:var(--text-faint); margin-top:5px; }
  .cp-section-head{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:8px; flex-wrap:wrap; }
  .cp-section-head .dc-label{ margin:0; }
  .cp-section-actions{ display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
  .cp-section-empty{ padding:4px 0; }
  .cp-complete-btn{ width:100%; text-align:left; padding:12px 14px; border-radius:10px; border:1.5px dashed var(--border); background:var(--surface-alt); color:var(--accent); font-weight:700; font-size:13.5px; cursor:pointer; font-family:inherit; }
  .cp-complete-btn:hover{ border-color:var(--accent); }
  .p-section-body .tag-list{ margin-top:4px; }
  .flow-tag{ display:inline-block; font-size:19px; line-height:1; flex:none; }
  .meal-time-settings{ display:flex; gap:16px; flex-wrap:wrap; align-items:flex-end; }
  .meal-time-settings label{ font-size:12.5px; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:var(--text-faint); display:block; margin-bottom:6px; }

  .visitor-row{ display:flex; align-items:center; justify-content:space-between; padding:10px 0; border-top:1px solid var(--border); gap:12px; }
  .visitor-row:first-child{ border-top:none; }
  .visitor-name{ font-weight:700; font-size:13.5px; }
  .visitor-rel{ font-size:12.5px; color:var(--text-muted); }
  .visitor-note{ font-size:12.5px; color:var(--text-faint); text-align:right; max-width:220px; }

