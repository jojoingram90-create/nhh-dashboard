/* ---------------- Local persistence (Phase 2a: on-device only, no server, no sync) ----------------
   This is the pilot's storage layer while it runs at a single house with no remote access — see the
   spec's Phase 2a section. Everything a house manager or caregiver enters (residents, care plans,
   daily care logs, calendar, incident reports, food photos, staff roster, etc.) is saved into this
   browser's IndexedDB so it survives a reload or the iPad restarting. IndexedDB (not localStorage) is
   used because food photos are stored as base64 data URLs and can be several MB total, well past
   localStorage's ~5-10MB quota.
   Nothing here is uploaded anywhere, and nothing syncs between devices — this is the explicit
   trade-off of running before the Phase 2 Supabase/remote-access build.
   Deliberately NOT persisted: state.userId (the current login) and other pure-navigation/session
   state (state.view, scroll/expand toggles, etc.) — a shared iPad must always come back to the
   PIN-lock screen on reload, never auto-log-in the last person who used it, and it's fine for the
   app to reopen on the Dashboard rather than wherever someone left it. */
const PERSIST_DB_NAME = "nhh_house_dashboard";
const PERSIST_DB_VERSION = 1;
const PERSIST_STORE = "snapshot";
const PERSIST_KEY = "current";
let persistDbPromise = null;
function openPersistDB(){
  if(!persistDbPromise){
    persistDbPromise = new Promise((resolve, reject) => {
      if(!window.indexedDB){ reject(new Error("IndexedDB not available in this browser")); return; }
      const req = indexedDB.open(PERSIST_DB_NAME, PERSIST_DB_VERSION);
      req.onupgradeneeded = () => { req.result.createObjectStore(PERSIST_STORE); };
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }
  return persistDbPromise;
}
// Every mutable, real-data collection in the app, gathered into one plain object. Pure UI/session
// state (the `state` object, pinBuffer, idleTimer, etc.) is intentionally excluded — see note above.
function buildSnapshot(){
  return {
    v: 1, savedAt: new Date().toISOString(),
    STAFF, residents, houses, houseMealTimesByHouse,
    carePlans, medicalInfo, visitors, comments, contacts, emergencyContactIdSeq,
    calendarEventIdSeq, calendarEvents,
    calendarSeriesIdSeq, calendarSeries,
    masterMenusByHouse, mealNoteIdSeq, residentMealNotes, breakfastOverrides,
    residentBreakfastPlans, breakfastPlanIdSeq, breakfastOverridesMigrated,
    commonMedIdSeq, commonMedications,
    MOBILITY_TYPES, TRANSFER_TYPES, TOILETING_TYPES, COMM_TYPES, DIET_TAGS, WEARABLE_TAGS,
    DIAGNOSIS_TAGS, diagnosisIdSeq, pendingDiagnoses, visitorIdSeq, commentIdSeq,
    ROUTINE_TYPES, residentRoutines, routineIdSeq,
    dailyCare, irIdSeq, incidentReports,
    foodPhotos, foodPhotoConfirmed, announcements, nextAnnId,
    houseContacts, houseContactIdSeq,
    suppliesReceived, suppliesIdSeq
  };
}
// Restores every collection above from a saved snapshot. STAFF/residents/carePlans/medicalInfo/
// visitors/comments/calendarEvents are declared `const`, so they're cleared and refilled in place;
// everything else is a plain reassignment of its `let` binding — every function elsewhere reads
// these by name at call time, so a reassignment here is picked up everywhere immediately.
function applySnapshot(snap){
  if(!snap) return;
  if(Array.isArray(snap.STAFF)){ STAFF.length = 0; STAFF.push(...snap.STAFF); }
  if(Array.isArray(snap.residents)){ residents.length = 0; residents.push(...snap.residents); }
  if(Array.isArray(snap.houses) && snap.houses.length){ houses.length = 0; houses.push(...snap.houses); }
  if(snap.houseMealTimesByHouse) houseMealTimesByHouse = snap.houseMealTimesByHouse;
  if(snap.carePlans){ Object.keys(carePlans).forEach(k=>delete carePlans[k]); Object.assign(carePlans, snap.carePlans); }
  if(snap.medicalInfo){ Object.keys(medicalInfo).forEach(k=>delete medicalInfo[k]); Object.assign(medicalInfo, snap.medicalInfo); }
  if(snap.visitors){ Object.keys(visitors).forEach(k=>delete visitors[k]); Object.assign(visitors, snap.visitors); }
  if(snap.comments){ Object.keys(comments).forEach(k=>delete comments[k]); Object.assign(comments, snap.comments); }
  if(snap.contacts){ Object.keys(contacts).forEach(k=>delete contacts[k]); Object.assign(contacts, snap.contacts); }
  if(typeof snap.emergencyContactIdSeq === "number") emergencyContactIdSeq = snap.emergencyContactIdSeq;
  if(Array.isArray(snap.houseContacts)) houseContacts = snap.houseContacts;
  if(typeof snap.houseContactIdSeq === "number") houseContactIdSeq = snap.houseContactIdSeq;
  if(Array.isArray(snap.suppliesReceived)) suppliesReceived = snap.suppliesReceived;
  if(typeof snap.suppliesIdSeq === "number") suppliesIdSeq = snap.suppliesIdSeq;
  if(typeof snap.calendarEventIdSeq === "number") calendarEventIdSeq = snap.calendarEventIdSeq;
  if(snap.calendarEvents){ Object.keys(calendarEvents).forEach(k=>delete calendarEvents[k]); Object.assign(calendarEvents, snap.calendarEvents); }
  if(typeof snap.calendarSeriesIdSeq === "number") calendarSeriesIdSeq = snap.calendarSeriesIdSeq;
  if(snap.calendarSeries) calendarSeries = snap.calendarSeries;
  if(snap.masterMenusByHouse) masterMenusByHouse = snap.masterMenusByHouse;
  if(typeof snap.mealNoteIdSeq === "number") mealNoteIdSeq = snap.mealNoteIdSeq;
  if(snap.residentMealNotes) residentMealNotes = snap.residentMealNotes;
  if(snap.breakfastOverrides) breakfastOverrides = snap.breakfastOverrides;
  if(snap.residentBreakfastPlans) residentBreakfastPlans = snap.residentBreakfastPlans;
  if(typeof snap.breakfastPlanIdSeq === "number") breakfastPlanIdSeq = snap.breakfastPlanIdSeq;
  if(typeof snap.breakfastOverridesMigrated === "boolean") breakfastOverridesMigrated = snap.breakfastOverridesMigrated;
  migrateBreakfastOverridesIfNeeded();
  if(typeof snap.commonMedIdSeq === "number") commonMedIdSeq = snap.commonMedIdSeq;
  if(Array.isArray(snap.commonMedications)) commonMedications = snap.commonMedications;
  if(Array.isArray(snap.MOBILITY_TYPES)) MOBILITY_TYPES = snap.MOBILITY_TYPES;
  if(Array.isArray(snap.TRANSFER_TYPES)) TRANSFER_TYPES = snap.TRANSFER_TYPES;
  if(Array.isArray(snap.TOILETING_TYPES)) TOILETING_TYPES = snap.TOILETING_TYPES;
  if(Array.isArray(snap.COMM_TYPES)) COMM_TYPES = snap.COMM_TYPES;
  if(Array.isArray(snap.DIET_TAGS)) DIET_TAGS = snap.DIET_TAGS;
  if(Array.isArray(snap.WEARABLE_TAGS)) WEARABLE_TAGS = snap.WEARABLE_TAGS;
  if(Array.isArray(snap.DIAGNOSIS_TAGS)) DIAGNOSIS_TAGS = snap.DIAGNOSIS_TAGS;
  if(typeof snap.diagnosisIdSeq === "number") diagnosisIdSeq = snap.diagnosisIdSeq;
  if(Array.isArray(snap.pendingDiagnoses)) pendingDiagnoses = snap.pendingDiagnoses;
  if(typeof snap.visitorIdSeq === "number") visitorIdSeq = snap.visitorIdSeq;
  if(typeof snap.commentIdSeq === "number") commentIdSeq = snap.commentIdSeq;
  if(Array.isArray(snap.ROUTINE_TYPES)) ROUTINE_TYPES = snap.ROUTINE_TYPES;
  if(snap.residentRoutines) residentRoutines = snap.residentRoutines;
  if(typeof snap.routineIdSeq === "number") routineIdSeq = snap.routineIdSeq;
  if(snap.dailyCare) dailyCare = snap.dailyCare;
  if(typeof snap.irIdSeq === "number") irIdSeq = snap.irIdSeq;
  if(snap.incidentReports) incidentReports = snap.incidentReports;
  if(snap.foodPhotos) foodPhotos = snap.foodPhotos;
  if(snap.foodPhotoConfirmed) foodPhotoConfirmed = snap.foodPhotoConfirmed;
  if(Array.isArray(snap.announcements)) announcements = snap.announcements;
  if(typeof snap.nextAnnId === "number") nextAnnId = snap.nextAnnId;
  // Shower Schedule is derived entirely from each restored resident's Care Plan hygiene section
  // (see syncShowerScheduleFromHygiene) rather than stored on its own — rebuild it here now that
  // residents/carePlans are back.
  residents.forEach(r => syncShowerScheduleFromHygiene(r.id));
}
let persistTimer = null;
let persistInFlight = false;
let persistQueuedAgain = false;
// Debounced so a burst of renders (typing, rapid taps) triggers one write, not dozens — 700ms after
// the last render(), not the last keystroke, since render() itself is already debounced/deferred
// upstream by scheduleRender() for the fields that matter.
function schedulePersist(){
  if(persistTimer) clearTimeout(persistTimer);
  persistTimer = setTimeout(writeSnapshotNow, 700);
}
async function writeSnapshotNow(){
  if(persistInFlight){ persistQueuedAgain = true; return; }
  persistInFlight = true;
  try{
    const db = await openPersistDB();
    const snap = buildSnapshot();
    await new Promise((resolve, reject) => {
      const tx = db.transaction(PERSIST_STORE, "readwrite");
      tx.objectStore(PERSIST_STORE).put(snap, PERSIST_KEY);
      tx.oncomplete = resolve;
      tx.onerror = () => reject(tx.error);
    });
  } catch(err){
    console.error("Local save failed — this device's storage may be full or unavailable:", err);
  } finally {
    persistInFlight = false;
    if(persistQueuedAgain){ persistQueuedAgain = false; schedulePersist(); }
  }
}
async function loadSnapshot(){
  const db = await openPersistDB();
  return new Promise((resolve, reject) => {
    const tx = db.transaction(PERSIST_STORE, "readonly");
    const req = tx.objectStore(PERSIST_STORE).get(PERSIST_KEY);
    req.onsuccess = () => resolve(req.result || null);
    req.onerror = () => reject(req.error);
  });
}
async function bootApp(){
  try{
    const snap = await loadSnapshot();
    if(snap) applySnapshot(snap);
  } catch(err){
    // No saved data yet, or this browser blocked/lacks IndexedDB (e.g. private browsing on some
    // browsers) — fall back to starting fresh rather than leaving the app stuck unrendered.
    console.error("Local load failed — starting fresh:", err);
  }
  syncResidentBirthdayEvents();
  render();
}

bootApp();
</script>
