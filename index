const CAL_KIND_OPTIONS = [ {value:"activity",label:"Activity"}, {value:"visit",label:"Visit"}, {value:"appointment",label:"Appointment"}, {value:"birthday",label:"Birthday"} ];

/* ---------------- Resident birthdays — auto-added to the Calendar ----------------
   Each resident's DOB (captured on their Care Plan) automatically gets a yearly Calendar entry rather
   than requiring anyone to enter it by hand. Auto-added events are tagged with birthdayOf/birthdayYear
   so this stays idempotent — re-running it never creates a duplicate for a resident+year that already
   has one, and it respects a manager's edit or (soft) delete of that event instead of re-creating it.
   Runs at boot and again whenever a resident is added or edited, so a newly-entered or changed DOB
   picks up its Calendar entry right away rather than waiting for a page reload. */
function birthdayIsoForYear(dob, year){
  if(!dob) return null;
  const parts = String(dob).split("-");
  if(parts.length !== 3) return null;
  const month = parseInt(parts[1],10), day = parseInt(parts[2],10);
  if(!month || !day) return null;
  const isLeapYear = y => (y%4===0 && y%100!==0) || y%400===0;
  const d = (month===2 && day===29 && !isLeapYear(year)) ? 28 : day; // Feb 29 birthdays land on Feb 28 in non-leap years
  return `${year}-${String(month).padStart(2,"0")}-${String(d).padStart(2,"0")}`;
}
function findBirthdayEvent(residentId, year){
  for(const day in calendarEvents){
    const found = (calendarEvents[day]||[]).find(e=>e.birthdayOf===residentId && e.birthdayYear===year);
    if(found) return found;
  }
  return null;
}
function syncResidentBirthdayEvents(){
  const thisYear = new Date().getFullYear();
  residents.forEach(r=>{
    if(!r.dob) return;
    [thisYear, thisYear+1].forEach(year=>{
      if(findBirthdayEvent(r.id, year)) return; // already generated (or a manager deleted it) — leave it alone
      const day = birthdayIsoForYear(r.dob, year);
      if(!day) return;
      if(!calendarEvents[day]) calendarEvents[day] = [];
      calendarEvents[day].push(ce(calendarEventIdSeq++, `🎂 ${r.name}'s Birthday`, "birthday", "", "", "System", "Auto-generated", { birthdayOf:r.id, birthdayYear:year, house:r.house }));
    });
  });
}
/* ---------------- Calendar recurrence engine ----------------
   There's no recurrence support in the underlying data — every calendarEvents entry is still a plain
   one-off row on one specific day. A "series" (calendarSeries) is the recurrence definition; generating
   it just pushes normal one-off rows for every matching date, each tagged with seriesId so the Calendar
   screen can offer "just this occurrence or the whole series?" on edit/delete, and so re-generating
   (see extendCalendarSeries) never creates a duplicate for a date that's already been generated —
   including a date whose generated occurrence was since edited or deleted, which is left alone. */
const CAL_REPEAT_OPTIONS = [
  {value:"none", label:"Does not repeat"},
  {value:"daily", label:"Daily"},
  {value:"weekly", label:"Specific day(s) of week"},
  {value:"biweekly", label:"Every other week"}
];
const CAL_WINDOW_OPTIONS = [ {value:1,label:"1 month"}, {value:3,label:"3 months"}, {value:6,label:"6 months"} ];
// Every date from the later of (series start, fromIso) through throughIso that matches the series'
// repeat pattern. repeatDays uses the same Mon-first day labels as HYGIENE_DAYS ("Mon".."Sun").
function seriesDatesInRange(series, fromIso, throughIso){
  const out = [];
  let cur = series.startDay > fromIso ? series.startDay : fromIso;
  const startWeekMonday = mondayOfIso(series.startDay);
  while(cur <= throughIso){
    const dow = HYGIENE_DAYS[(parseIso(cur).getDay()+6)%7]; // JS getDay() (Sun=0) -> Mon-first label
    if(series.repeat === "daily"){
      out.push(cur);
    } else if(series.repeat === "weekly"){
      if(series.repeatDays.includes(dow)) out.push(cur);
    } else if(series.repeat === "biweekly"){
      if(series.repeatDays.includes(dow)){
        const curWeekMonday = mondayOfIso(cur);
        const weeksBetween = Math.round((parseIso(curWeekMonday) - parseIso(startWeekMonday)) / (7*86400000));
        if(weeksBetween % 2 === 0) out.push(cur);
      }
    }
    cur = addDaysIso(cur, 1);
  }
  return out;
}
function generateSeriesEvents(series){
  seriesDatesInRange(series, series.startDay, series.generatedThrough).forEach(day=>{
    const already = (calendarEvents[day]||[]).some(e=>e.seriesId===series.id);
    if(already) return; // already generated for this date — including if a manager since edited or deleted it
    if(!calendarEvents[day]) calendarEvents[day] = [];
    calendarEvents[day].push(ce(calendarEventIdSeq++, series.title, series.kind, series.time, series.notes, series.createdBy, series.createdAt, { seriesId: series.id, house: series.house }));
  });
}
function seriesSummaryLabel(series){
  if(!series) return "";
  if(series.repeat==="daily") return "Repeats daily";
  if(series.repeat==="weekly") return `Repeats weekly — ${series.repeatDays.join(", ")}`;
  if(series.repeat==="biweekly") return `Repeats every other week — ${series.repeatDays.join(", ")}`;
  return "";
}
// Surfaced on the Calendar screen once a series' generated window is within 2 weeks of running out —
// resolved (confirmed with Johnna): prompt whoever's looking at it to regenerate for another period, or
// mark the series complete. Keeps prompting on every visit until one of those happens (no snooze), since
// letting a repeating event quietly stop mid-series is the failure mode this is guarding against.
function activeCalendarSeriesNeedingRenewal(){
  return Object.values(calendarSeries).filter(s=>s.house===state.house && s.status==="active" && addDaysIso(s.generatedThrough,-14) <= todayIso());
}
function extendCalendarSeries(seriesId){
  if(!moduleEdit('calendar')) return;
  const series = calendarSeries[seriesId];
  if(!series) return;
  series.generatedThrough = addMonthsIso(series.generatedThrough, series.windowMonths);
  generateSeriesEvents(series);
  scheduleRender();
}
function completeCalendarSeries(seriesId){
  if(!moduleEdit('calendar')) return;
  const series = calendarSeries[seriesId];
  if(!series) return;
  series.status = "complete";
  scheduleRender();
}
function getCalEvent(day, id){ return (calendarEvents[day]||[]).find(e=>e.id===id); }
function fmtIsoLabel(iso){ const d = parseIso(iso); return `${DOW_SHORT[d.getDay()]}, ${MONTH_LONG[d.getMonth()].slice(0,3)} ${d.getDate()}`; }
function fmtDayLabelIso(iso){ return fmtDayLabel(parseIso(iso)); }
// Which week the Calendar screen is currently showing — defaults to the real current week and moves
// by 7 real days at a time via Prev/Next Week, so the calendar keeps going indefinitely rather than
// being limited to one fixed week.
function currentCalendarWeekStart(){ return state.calendarWeekStart || mondayOfIso(TODAY_ISO); }
function shiftCalendarWeek(delta){
  state.calendarWeekStart = addDaysIso(currentCalendarWeekStart(), delta*7);
  scheduleRender();
}
function openAddEventModal(){
  if(!moduleEdit('calendar')) return;
  const days = weekDatesFrom(currentCalendarWeekStart());
  state.calendarModal = { mode:"add", day: days.includes(TODAY_ISO) ? TODAY_ISO : days[0], title:"", time:"", notes:"", kind:"activity", repeat:"none", repeatDays:[], windowMonths:1, repeatError:null };
  scheduleRender();
}
// Which id suffix the currently-open form's fields use — lets the chip setters below (Type, Repeat, day
// picker, window) find and preserve whatever's already typed into Title/Time/Notes before they trigger
// a re-render, since those three are plain inputs read into modal state on demand rather than after
// every keystroke (see syncCalendarModalFormToState()).
function calendarModalIdSuffix(){
  const m = state.calendarModal;
  if(!m) return "new";
  if(m.mode==="edit") return "edit";
  if(m.mode==="editseries") return "editseries";
  return "new";
}
function syncCalendarModalFormToState(idSuffix){
  const m = state.calendarModal;
  if(!m) return;
  const titleEl = document.getElementById(`cal-title-${idSuffix}`); if(titleEl) m.title = titleEl.value;
  const timeEl = document.getElementById(`cal-time-${idSuffix}`); if(timeEl) m.time = timeEl.value;
  const notesEl = document.getElementById(`cal-notes-${idSuffix}`); if(notesEl) m.notes = notesEl.value;
}
