}
// Deletes every not-yet-deleted occurrence of the series (each stays soft-deleted/restorable, same as a
// single occurrence) and marks the series itself complete so it stops generating further occurrences.
function confirmDeleteSeries(seriesId){
  if(!moduleEdit('calendar')) return;
  const who = currentUser().name;
  Object.keys(calendarEvents).forEach(d=>{
    (calendarEvents[d]||[]).forEach(e=>{
      if(e.seriesId===seriesId && !e.deleted){
        e.deleted = true; e.deletedBy = who; e.deletedAt = "Just now";
      }
    });
  });
  const series = calendarSeries[seriesId];
  if(series) series.status = "complete";
  state.calendarModal = null;
  scheduleRender();
}
function restoreEvent(day, id){
  if(!moduleEdit('calendar')) return;
  const ev = getCalEvent(day, id);
  if(!ev) return;
  ev.deleted = false;
  ev.deletedBy = null;
  ev.deletedAt = null;
  scheduleRender();
}
function toggleDeletedEvents(){
  state.showDeletedEvents = !state.showDeletedEvents;
  scheduleRender();
}
function allDeletedEvents(){
  const out = [];
  // Events now live on any real date, not one fixed set of 7 labels — walk every date that actually
  // has events rather than a hardcoded week.
  Object.keys(calendarEvents).forEach(d=>(calendarEvents[d]||[]).forEach(e=>{ if(e.deleted) out.push({ day:d, ...e }); }));
  return out.sort((a,b)=> a.day < b.day ? 1 : -1); // most recently deleted week first
}
