// Accepts a normal youtube.com/watch, youtu.be, /shorts/, or existing /embed/ link and returns an
// embeddable player URL, or "" if the link doesn't look like a YouTube video.
function youtubeEmbedUrl(url){
  if(!url) return "";
  try{
    const u = new URL(url);
    let id = "";
    if(u.hostname.includes("youtu.be")) id = u.pathname.slice(1);
    else if(u.searchParams.get("v")) id = u.searchParams.get("v");
    else if(u.pathname.includes("/embed/")) id = u.pathname.split("/embed/")[1];
    else if(u.pathname.includes("/shorts/")) id = u.pathname.split("/shorts/")[1];
    id = (id || "").split("&")[0].split("?")[0].split("/")[0];
    return id ? `https://www.youtube.com/embed/${id}` : "";
  } catch(e){ return ""; }
}
