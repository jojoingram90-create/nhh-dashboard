function sectionKeyForPath(path){
  if(path==="water") return "water";
  if(path.startsWith("meals.breakfast")) return "breakfast";
  if(path.startsWith("meals.lunch")) return "lunch";
  if(path.startsWith("meals.dinner")) return "dinner";
  if(path.startsWith("prn")) return "medEvents";
