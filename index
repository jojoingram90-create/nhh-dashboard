      ${list.map(r=>{
        const cp = carePlans[r.id] || {};
        const dietTags = (cp.diet && cp.diet.tags) || [];
        const dietDetails = cp.diet && cp.diet.details;
        const allergies = (cp.allergies||[]).filter(a => a && a.trim().toLowerCase() !== "none known");
        const notes = residentMealNotes[r.id] || [];
        return `<div class="diet-resident-card">
          <div class="diet-resident-head">${r.name}</div>
          <div class="diet-chip-row">
            ${dietTags.map(t=>`<span class="tag diet-tag">${esc(t)}</span>`).join("")}
            ${allergies.map(a=>`<span class="tag allergy-tag">⚠ ${esc(a)} allergy</span>`).join("")}
            ${(!dietTags.length && !allergies.length) ? `<span class="hint" style="margin:0; font-style:italic;">No standing dietary restrictions on file.</span>` : ""}
          </div>
          ${dietDetails ? `<div class="diet-details-text">${esc(dietDetails)}</div>` : ""}
          <div class="diet-instructions-label">Special instructions</div>
          <div class="diet-instructions">
            ${notes.length ? notes.map(n=>{
              const pending = state.mealNoteDeletePending;
              if(pending && pending.residentId===r.id && pending.noteId===n.id){
                return `<span class="meal-note-chip meal-note-confirm">Delete this instruction?
                  <button class="btn small primary" onclick="confirmDeleteMealNote('${r.id}',${n.id})">Delete</button>
                  <button class="btn small" onclick="cancelDeleteMealNote()">Cancel</button>
                </span>`;
              }
              const pendingApproval = n.status === "pending";
              return `<span class="meal-note-chip ${pendingApproval ? 'meal-note-pending' : ''}">
                ${esc(n.text)}
                ${pendingApproval ? badge("fall","Pending approval") : ""}
                <span class="meal-note-by">— ${esc(n.addedBy)}</span>
                ${pendingApproval && moduleEdit('menu') ? `<button class="btn small primary" onclick="approveMealNote('${r.id}',${n.id})">Approve</button>` : ""}
                ${moduleEdit('menu') ? `<button class="meal-note-remove" onclick="requestDeleteMealNote('${r.id}',${n.id})" title="Remove">✕</button>` : ""}
              </span>`;
            }).join("") : "<span class='hint' style='margin:0; font-style:italic;'>None on file.</span>"}
          </div>
          <div class="meal-note-add">
            <input type="text" id="mealNoteInput-${r.id}" placeholder="Add an instruction for ${r.name.split(' ')[0]}...">
            <button class="btn small" onclick="addMealNote('${r.id}')">Add</button>
          </div>
        </div>`;
      }).join("")}
    </div>
  </div>

  ${state.recipeModal ? renderRecipeModal() : ""}
  ${state.breakfastPrefsOpen ? renderBreakfastPrefsModal() : ""}`;
}
