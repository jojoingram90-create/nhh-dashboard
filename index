    state.houseRemovePending = null;
    scheduleRender();
    return;
  }
  const idx = houses.findIndex(h=>h.id===houseId);
  if(idx>=0) houses.splice(idx,1);
  if(state.house===houseId) state.house = houses[0].id;
  if(state.houseEditingId===houseId) state.houseEditingId = null;
  state.houseRemovePending = null;
  scheduleRender();
}
