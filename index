      <dt>Meal times</dt><dd>Breakfast ${formatTime12(effectiveMealTime(residentId,'breakfast'))}, Lunch ${formatTime12(effectiveMealTime(residentId,'lunch'))}, Dinner ${formatTime12(effectiveMealTime(residentId,'dinner'))}</dd>
