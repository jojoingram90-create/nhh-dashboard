}
function renderBreakfastPlanRow(p){
  const removing = state.breakfastPlanDeletePending === p.id;
  if(removing){
    return `<div class="card" style="padding:12px 14px;">
      <div style="font-weight:700; margin-bottom:8px;">Delete ${esc(p.label)}?</div>
      <div class="routine-quicklog-actions">
        <button class="btn primary small" onclick="confirmDeleteBreakfastPlan(${p.id})">Delete</button>
        <button class="btn small" onclick="cancelDeleteBreakfastPlan()">Cancel</button>
      </div>
    </div>`;
  }
  const daysText = p.scope==="all" ? "Every day" : ((p.days||[]).join(", ") || "No days chosen yet");
  const itemsText = breakfastPlanItemsText(p);
  return `<div class="card" style="padding:12px 14px;">
    <div style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; align-items:flex-start;">
      <div>
        <div style="font-weight:700;">${esc(p.label)}</div>
        <div style="font-size:13px; margin:3px 0;">${itemsText ? esc(itemsText) : `<span class="hint">No items chosen</span>`}</div>
        <div class="hint" style="margin:0;">${esc(daysText)}</div>
      </div>
      ${moduleEdit('menu') ? `<div class="routine-quicklog-actions" style="margin-top:0;">
        <button class="btn small" onclick="editBreakfastPlan(${p.id})">✎ Edit</button>
        <button class="btn small" onclick="requestDeleteBreakfastPlan(${p.id})">Delete</button>
      </div>` : ""}
    </div>
  </div>`;
}
