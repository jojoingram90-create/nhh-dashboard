}
// Daily care logs are keyed by real ISO date, THEN resident: dailyCare[date][residentId] — one
// separate record per resident per real day, matching the spec's `daily_care_logs` model, rather than
// one flat record that "today's" entries would otherwise silently overwrite forever. Starts empty for
// the live pilot; each day's bucket is created the first time anyone documents something on it.
let dailyCare = {};
// Reads/writes always resolve against a specific day: state.dcViewDate while actively browsing the
// Daily Care Log screen (see shiftDailyCareDate below), otherwise today. Today's Flow and the quick-log
// panels never set dcViewDate, so they always resolve to today regardless of what's being browsed
// elsewhere. Past days are enforced read-only in the UI (renderDailyCareDetail), not here — same
// "gate the controls, not the function" pattern used for module permissions throughout this app.
function getDC(residentId, dateKey){
  const key = dateKey || state.dcViewDate || todayIso();
  if(!dailyCare[key]) dailyCare[key] = {};
  if(!dailyCare[key][residentId]) dailyCare[key][residentId] = defaultDailyCare();
  return dailyCare[key][residentId];
}
function getPath(obj,path){ return path.split(".").reduce((o,k)=> (o==null ? o : o[k]), obj); }
function setPath(obj,path,value){ const parts=path.split("."); let cur=obj; for(let i=0;i<parts.length-1;i++){ cur = cur[parts[i]]; } cur[parts[parts.length-1]] = value; }

