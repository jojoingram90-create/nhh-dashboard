/* ---------------- Manage Houses (Leadership only) ----------------
   Adding a house here is what makes every other per-house screen (Residents, Care Plans, Daily Care,
   Calendar, Food Menu, Supplies, Directory, house meal times) start working for it — each of those
   reads/writes through a `state.house`-scoped accessor or filter (see currentHouseMealTimes(),
   currentMasterMenu(), houseResidents(), currentHouseContacts(), the calendar/announcement `.house`
   filters, etc.), all of which lazily initialize a brand-new house's own empty data the first time
   it's touched — nothing needs to be pre-seeded here beyond the house record itself. Food Photo QC and
   Staff stay intentionally cross-house (unchanged) — every other module is now genuinely independent
   per house, matching how Boca Bay has always worked. Same add/edit/remove shape as Manage Staff and
   the Directory above: sync-before-mutate free-text fields, inline edit, and a guarded two-step
   confirm-before-remove (blocked outright — not just confirmed — if the house still has residents or
   staff on it, or is the only house left, so a house can't be silently deleted out from under its data). */
function slugifyHouseId(name){
  const base = (name||"").toLowerCase().trim().replace(/[^a-z0-9]+/g,"-").replace(/(^-|-$)/g,"") || "house";
  let id = base, n = 2;
  while(houses.some(h=>h.id===id)){ id = `${base}-${n++}`; }
  return id;
}
function toggleHouseAdd(){
