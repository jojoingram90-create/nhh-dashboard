// or edit here (that's entirely per-resident now, see Piece 2/item 44) — its row is a per-day "See more"
// expand instead (item 46); Lunch/Dinner are unchanged, master-menu-driven rows with Week A/B and Recipe
// (the Recipe/video button intentionally stays off Breakfast — it no longer has one dish to attach a
// recipe to, and Week A/B rotation stays scoped to Lunch/Dinner only, exactly as before).
function renderFullMenuCard(viewWeek, activeWeek, isAdmin, editingMenu){
  const masterMeals = ["Lunch","Dinner"];
  const list = houseResidents();
  return `
  <div class="card" style="overflow-x:auto;">
    <div class="menu-week-bar" style="padding-bottom:14px; margin-bottom:14px; border-bottom:1px solid var(--border);">
      <div class="menu-week-tabs">
        <button class="btn small ${viewWeek==='A' ? 'primary' : ''}" onclick="setMenuViewWeek('A')">Week A${activeWeek==='A' ? ' · Active' : ''}</button>
        <button class="btn small ${viewWeek==='B' ? 'primary' : ''}" onclick="setMenuViewWeek('B')">Week B${activeWeek==='B' ? ' · Active' : ''}</button>
      </div>
      <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
        <span class="hint" style="margin:0;">${isAdmin ? "Menu items are fixed — tap “✎ Edit Menu” to make changes." : "Only Johnna, Tucker, and Buke can edit the master menu."}</span>
        ${isAdmin ? `<button class="btn small" onclick="toggleMenuEditing()">${editingMenu ? "Done" : "✎ Edit Menu"}</button>` : ""}
      </div>
    </div>
    <table class="menu-table">
      <tr><th>Meal</th>${menuDays.map(d=>`<th>${d}</th>`).join("")}</tr>
      <tr><td style="font-weight:700">Breakfast</td>${menuDays.map(d=>{
        const expanded = !!state.menuBreakfastExpandedDays[d];
        return `<td>
          <button class="btn small" onclick="toggleMenuBreakfastDay('${d}')">${expanded ? "▾" : "▸"} See more</button>
          ${expanded ? `<div class="menu-breakfast-expand">${list.length ? list.map(r=>{
            const plan = breakfastPlanForDow(r.id, d);
            return `<div class="menu-breakfast-resident"><span class="who">${esc(r.name)}</span>${plan ? `: ${esc(breakfastPlanItemsText(plan))}` : ` <span class="hint" style="font-style:italic;">Not set</span>`}</div>`;
          }).join("") : `<span class="hint" style="font-style:italic;">No residents yet.</span>`}</div>` : ""}
        </td>`;
      }).join("")}</tr>
      ${masterMeals.map(m=>`<tr><td style="font-weight:700">${m}</td>${menuDays.map(d=>{
        const cell = currentMasterMenu()[viewWeek][m][d];
        return `<td><div class="menu-item">
          ${editingMenu
            ? `<input type="text" class="menu-item-input" value="${esc(cell.item)}" onchange="setMenuItem('${viewWeek}','${m}','${d}',this.value)">`
            : `<div class="menu-item-name">${esc(cell.item)}</div>`}
          <button class="btn small recipe-btn" onclick="openRecipeModal('${viewWeek}','${m}','${d}')">📖 Recipe${cell.videoUrl ? " · 🎥" : ""}</button>
        </div></td>`;
      }).join("")}</tr>`).join("")}
    </table>
  </div>`;
}
