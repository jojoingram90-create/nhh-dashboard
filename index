  const canEdit = moduleEdit('residents');
  // Care Plan uses ONE Edit/Save/Print control for the whole tab, not one per field (Johnna's call,
  // Sept 2026) — tapping Edit unlocks every field at once, and Save writes and locks them all together.
  // A still-empty field keeps its own "+ Complete X" prompt, which also opens this same whole-tab edit
  // mode; a filled field just reads as plain text until Edit is tapped.
