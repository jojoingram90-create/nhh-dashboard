/* ---------------- Food photo quality control (cross-house) ---------------- */
const MEAL_CATS = ["salad","lunch","dessert"];
const CAT_META = { salad:{label:"Salad", icon:"🥗"}, lunch:{label:"Lunch", icon:"🍽️"}, dessert:{label:"Dessert", icon:"🍰"} };

// Starts empty for the live pilot — real photos accumulate under real dates as they're uploaded.
// Browsing is bounded by shiftPhotoDate below (never past real "today"; back in time is unbounded)
// rather than a fixed PHOTO_DATES allow-list, so this keeps working indefinitely.
let foodPhotos = {};

// A house can upload/replace its own salad/lunch/dessert photos freely — nothing here is visible to
// any other house yet. Only once all three are uploaded and the house taps "Confirm Pictures" does
// foodPhotoConfirmed[date][houseId] get set (see confirmFoodPhotosNow below), which both locks that
// house out of replacing them and is the ONLY thing that makes them visible to every other house (see
// the `revealPhoto` check in renderFoodPhotos). Leadership can reverse a confirm via unlockFoodPhotosNow
// if a house needs to fix a photo after posting (agreed with Johnna, Sept 2026) — that re-opens
// uploading for that house/date and hides the photos from other houses again until re-confirmed.
let foodPhotoConfirmed = {};

function photoLockKey(date, houseId){ return date + "::" + houseId; }
function isPhotosConfirmed(date, houseId){ return !!((foodPhotoConfirmed[date]||{})[houseId]); }
function photoConfirmedInfo(date, houseId){ return (foodPhotoConfirmed[date]||{})[houseId] || null; }
// Status for a house that hasn't confirmed yet — deliberately blind to draft upload progress so
// browsing houses never learn a photo exists before it's officially posted.
function unconfirmedPhotoStatus(date){
  const deadline = new Date(date+"T19:00:00");
  return nowRef() > deadline ? "missing" : "pending";
}
function shiftPhotoDate(delta){
  const next = addDaysIso(state.photoDate, delta);
  if(next > todayIso()) return; // never browse into the future
  state.photoDate = next;
  render();
}
function handlePhotoUpload(evt, houseId, cat){
  if(isPhotosConfirmed(state.photoDate, houseId)){ evt.target.value = ""; return; } // locked — must be unlocked first
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e){
    if(!foodPhotos[state.photoDate]) foodPhotos[state.photoDate] = {};
    if(!foodPhotos[state.photoDate][houseId]) foodPhotos[state.photoDate][houseId] = {};
    foodPhotos[state.photoDate][houseId][cat] = { by: currentUser().name, at:"Just now", img: e.target.result };
    render();
  };
  reader.readAsDataURL(file);
}
function requestConfirmFoodPhotos(houseId){
  if(houseId !== state.house) return;
  const dayData = (foodPhotos[state.photoDate]||{})[houseId] || {};
  if(!MEAL_CATS.every(c=>dayData[c])) return; // all three required before confirming, per Johnna
  state.foodPhotoConfirmPending = photoLockKey(state.photoDate, houseId);
  scheduleRender();
}
function cancelConfirmFoodPhotos(){
  state.foodPhotoConfirmPending = null;
  scheduleRender();
}
function confirmFoodPhotosNow(houseId){
  state.foodPhotoConfirmPending = null;
  if(houseId !== state.house) { scheduleRender(); return; }
  const dayData = (foodPhotos[state.photoDate]||{})[houseId] || {};
  if(!MEAL_CATS.every(c=>dayData[c])) { scheduleRender(); return; }
  if(!foodPhotoConfirmed[state.photoDate]) foodPhotoConfirmed[state.photoDate] = {};
  foodPhotoConfirmed[state.photoDate][houseId] = { by: currentUser().name, at:"Just now" };
  scheduleRender();
}
function requestUnlockFoodPhotos(houseId){
  if(!isSystemAdmin()) return;
  state.foodPhotoUnlockPending = photoLockKey(state.photoDate, houseId);
  scheduleRender();
}
function cancelUnlockFoodPhotos(){
  state.foodPhotoUnlockPending = null;
  scheduleRender();
}
function unlockFoodPhotosNow(houseId){
  state.foodPhotoUnlockPending = null;
  if(!isSystemAdmin()) { scheduleRender(); return; }
  if(foodPhotoConfirmed[state.photoDate]) delete foodPhotoConfirmed[state.photoDate][houseId];
  scheduleRender();
}
function openLightbox(src){
  if(!src) return;
  document.getElementById("lightboxImg").src = src;
  document.getElementById("photoLightbox").style.display = "flex";
}
function closeLightbox(){
  document.getElementById("photoLightbox").style.display = "none";
  document.getElementById("lightboxImg").src = "";
}
function renderFoodPhotos(){
  const dateLabel = new Date(state.photoDate+"T12:00:00").toLocaleDateString('en-US',{weekday:'long', month:'long', day:'numeric'});

  // Summary strip is deliberately blind to draft upload progress — it only ever reflects whether a
  // house has confirmed (posted), so browsing the overview never hints that an unconfirmed photo exists.
  const summaryCards = houses.map(h=>{
    const confirmed = isPhotosConfirmed(state.photoDate, h.id);
    const status = confirmed ? "posted" : unconfirmedPhotoStatus(state.photoDate);
    const kind = status==="posted" ? "good" : status==="missing" ? "alert" : "fall";
    const label = status==="posted" ? "Posted" : status==="missing" ? "Missing" : "Due by 7 PM";
    return `<div class="card stat-tile">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:8px;">
        <div style="font-size:13.5px; font-weight:700;">${h.name}</div>
        ${badge(kind, label)}
      </div>
    </div>`;
  }).join("");

  const houseSections = houses.map(h=>{
    const dayData = (foodPhotos[state.photoDate]||{})[h.id] || {};
    const canUploadHere = h.id === state.house;
    const confirmed = isPhotosConfirmed(state.photoDate, h.id);
    const confirmInfo = photoConfirmedInfo(state.photoDate, h.id);
    const key = photoLockKey(state.photoDate, h.id);
    const allUploaded = MEAL_CATS.every(c=>dayData[c]);

    const slots = MEAL_CATS.map(c=>{
      const entry = dayData[c];
      const meta = CAT_META[c];
      // Cross-house viewers never see a draft — only the owning house sees its own uploads pre-confirm.
      // Once confirmed, the photo is locked in and visible to everyone (the whole point of Confirm Pictures).
      const revealPhoto = confirmed || canUploadHere;
      const media = (revealPhoto && entry && entry.img)
        ? `<img class="photo-thumb" src="${entry.img}" alt="${meta.label} photo" onclick="openLightbox(this.src)">`
        : `<div class="photo-placeholder">${meta.icon}</div>`;

      let statusBadge, attribution = "";
      if(confirmed){
        statusBadge = badge("good","Posted");
        attribution = entry ? `<div style="font-size:12px; color:var(--text-faint);">${entry.by} · ${entry.at}</div>` : "";
      } else if(canUploadHere && entry){
        statusBadge = badge("neutral","Uploaded — not posted yet");
        attribution = `<div style="font-size:12px; color:var(--text-faint);">${entry.by} · ${entry.at}</div>`;
      } else {
        const s = unconfirmedPhotoStatus(state.photoDate);
        statusBadge = s==="missing" ? badge("alert","Missing") : badge("fall","Due by 7 PM");
      }

      const inputId = `photo-${h.id}-${c}-${state.photoDate}`;
      const uploadControl = (canUploadHere && !confirmed) ? `
        <label class="btn small" for="${inputId}">${entry?"Replace":"Upload"}</label>
        <input type="file" accept="image/*" id="${inputId}" style="display:none" onchange="handlePhotoUpload(event,'${h.id}','${c}')">` : "";
      return `<div class="photo-slot">
        ${media}
        <div style="font-weight:700; font-size:13px;">${meta.label}</div>
        ${statusBadge}
        ${attribution}
        ${uploadControl}
      </div>`;
    }).join("");

    let lockAction = "";
    if(confirmed){
      const unlockControl = !isSystemAdmin() ? "" : (state.foodPhotoUnlockPending === key
        ? `<span class="hint" style="font-weight:600;">Unlock so this house can replace today's photos?</span>
           <button class="btn primary small" onclick="unlockFoodPhotosNow('${h.id}')">Unlock</button>
           <button class="btn small" onclick="cancelUnlockFoodPhotos()">Cancel</button>`
        : `<button class="btn small" onclick="requestUnlockFoodPhotos('${h.id}')">Unlock</button>`);
      lockAction = `<div class="photo-lock-row">
        ${badge("good", `🔒 Locked${confirmInfo ? ` · confirmed by ${confirmInfo.by} · ${confirmInfo.at}` : ''}`)}
        ${unlockControl}
      </div>`;
    } else if(canUploadHere){
      lockAction = state.foodPhotoConfirmPending === key
        ? `<div class="photo-lock-row">
             <span class="hint" style="font-weight:600;">Lock in today's photos for every house to see?</span>
             <button class="btn primary small" onclick="confirmFoodPhotosNow('${h.id}')">Confirm Pictures</button>
             <button class="btn small" onclick="cancelConfirmFoodPhotos()">Cancel</button>
           </div>`
        : allUploaded
          ? `<div class="photo-lock-row"><button class="btn primary small" onclick="requestConfirmFoodPhotos('${h.id}')">🔒 Confirm Pictures</button></div>`
          : `<div class="photo-lock-row"><span class="hint">Upload all three to confirm and post them</span></div>`;
    }

    return `<div class="card house-photo-card">
      <div class="house-photo-head">
        <h3 style="font-size:14px;">${h.name}${canUploadHere ? ' <span class="shift-tag" style="margin-left:6px;">Your house</span>' : ''}</h3>

        ${lockAction}
      </div>
      <div class="photo-grid">${slots}</div>
    </div>`;
  }).join("");

  document.getElementById("content").innerHTML = `
  <div class="section">
    <div class="section-head">
      <h2>Food Photo Quality Control</h2>
      <div class="date-nav">
        <button class="btn small" onclick="shiftPhotoDate(-1)">←</button>
        <span style="font-weight:700; font-size:13px;">${dateLabel}${state.photoDate===todayIso() ? " (Today)" : ""}</span>
        <button class="btn small" onclick="shiftPhotoDate(1)" ${state.photoDate>=todayIso()?'disabled':''}>→</button>
      </div>
    </div>
    <div style="font-size:13px; color:var(--text-faint); margin-bottom:14px;">Salad, lunch, and dessert photos are due from every house by 7:00 PM daily. Upload and replace freely — once all three are up, tap Confirm Pictures to lock them in and post them for every house to see as an NHH-wide quality standard.</div>
    <div class="stat-strip" style="grid-template-columns:repeat(${houses.length},1fr); margin-bottom:18px;">${summaryCards}</div>
    <div style="display:flex; flex-direction:column; gap:14px;">${houseSections}</div>
  </div>`;
}

