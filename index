function medAnchorsForMed(med){
  return (med.times||[]).map(t=>{
    if(t==="other"){
      if(!med.otherTime) return null;
      return { anchor:`other-${med.otherTime}`, label:medTimeLabel("other", med.otherTime), time:med.otherTime };
    }
    return { anchor:t, label:medTimeLabel(t), time:null };
  }).filter(Boolean);
}
function medLogKey(medId, anchor){ return medId+"::"+anchor; }
