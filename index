// ---- Calendar: rolling real weeks, not one fixed demo week ----
// Events are keyed by real ISO date ("2026-09-14"), not a fixed "Mon 7"-style label, so the calendar
// keeps working for every week going forward rather than being frozen on one walkthrough week.
// mondayOfWeek/weekDates below compute whichever week is being viewed (state.calendarWeekStart,
// defaulting to the real current week) from the real calendar, and Prev/Next Week move that anchor
// by 7 days indefinitely in either direction — see renderCalendar().
function mondayOfIso(iso){
  const d = parseIso(iso);
  const dow = d.getDay(); // 0=Sun..6=Sat
  const diff = dow === 0 ? -6 : 1 - dow; // shift back to Monday
  d.setDate(d.getDate() + diff);
  return isoDate(d);
}
function weekDatesFrom(mondayIso){
  const out = [];
  for(let i=0;i<7;i++) out.push(addDaysIso(mondayIso, i));
  return out;
}
