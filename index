// Single source of truth for a medication's Pass/Refuse status at one anchor time — called from both
// the Today's Flow "Log Meds" quick-log panel and the full Daily Care Log's Medications section, so
// either one logging a dose immediately shows up in the other (same dc.medications record).
// Correction, not silent overwrite (this is what makes the log trustworthy as an eventual official
// MAR, not just a checkbox): the first time a dose is logged, it's just recorded normally. Logging it
// again with a DIFFERENT status or reason — a genuine correction, not just re-tapping the same
// answer — pushes the old value onto that entry's own `corrections` history before the new value takes
// its place, the same "who/when actually changed this" principle already used for Calendar edits
// elsewhere in this app. Nothing is ever silently replaced with no trace of what it used to say.
function setMedStatus(residentId, medId, anchor, status, reason){
  const dc = getDC(residentId);
  if(!dc.medications) dc.medications = {};
  const key = medLogKey(medId, anchor);
  const existing = dc.medications[key];
  const who = currentUser();
  const isCorrection = existing && (existing.status !== status || (status === "refuse" && (existing.reason||"") !== (reason||"")));
  const corrections = existing ? (existing.corrections || []) : [];
  if(isCorrection){
    corrections.push({ status: existing.status, reason: existing.reason||"", by: existing.by, initials: existing.initials, at: existing.at });
  }
  dc.medications[key] = { status, reason: reason||"", by: who.name, initials: who.initials, at: "Just now", corrections };
  touchSection(dc, "medications", currentUser());
}
