function confirmDeleteEvent(day, id){
  if(!moduleEdit('calendar')) return;
  const ev = getCalEvent(day, id);
  if(!ev) return;
  ev.deleted = true;
  ev.deletedBy = currentUser().name;
  ev.deletedAt = "Just now";
  state.calendarModal = null;
