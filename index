/* ---------------- Staff directory & PIN lock ---------------- */
// In the real build, PINs are never sent to or checked by the client — this is a
// prototype simplification. See the spec's security note (server-side hashed PIN
// check via a Supabase Edge Function / RPC, with attempt rate-limiting).
// Real accounts only, for the live pilot — the fictional demo house manager/caregivers (Priya, Marcus,
// Selena) are gone. Johnna, Tucker, and Buke are kept since they're real New Horizon staff who also
// hold the master-menu-admin allow-list (MENU_ADMINS, above). Real house manager and caregiver
// accounts for this house get added from Manage Staff once the pilot is live — change these three PINs
// there too, whenever you're ready; 4444/5555/6666 are just carried-over placeholders from the design walkthrough.
// Each staff member's `house` is their default/home house — it's what state.house is set to the
// moment they log in (see pinDigit()). For House Manager/Caregiver/PRN it's effectively their only
// house, since the house picker stays locked for every non-leadership role (see renderSidebar()).
// Leadership can still switch to any house afterward — their picker isn't locked — so `house` for
// them is just which house they land on by default, set (and editable) from Manage Houses/Manage Staff.
const STAFF = [
  { id:"johnna", pin:"4444", name:"Johnna", role:"leadership", label:"Leadership", rail:"var(--hospice-dot)", shift:"n/a", initials:"J", house:"boca-bay" },
  { id:"tucker", pin:"5555", name:"Tucker", role:"leadership", label:"Leadership", rail:"var(--hospice-dot)", shift:"n/a", initials:"T", house:"boca-bay" },
  { id:"buke",   pin:"6666", name:"Buke",   role:"leadership", label:"Leadership", rail:"var(--hospice-dot)", shift:"n/a", initials:"B", house:"boca-bay" }
];
function currentUser(){ return STAFF.find(s=>s.id===state.userId) || null; }
const IDLE_LOCK_MS = 2 * 60 * 1000; // auto-lock after 2 minutes of no taps/clicks
let idleTimer = null;
let pinBuffer = "";
let pinError = false;

function lockApp(){
  if(!state.userId) return; // already locked
  // don't lose anything the current user was mid-typing
  if(document.activeElement && typeof document.activeElement.blur === "function") document.activeElement.blur();
  if(state.view==="dailycaredetail" && state.dcResidentId) syncFormToState(state.dcResidentId);
  state.userId = null;
  pinBuffer = "";
  pinError = false;
  render();
}
function resetIdleTimer(){
  if(idleTimer) clearTimeout(idleTimer);
  if(state.userId) idleTimer = setTimeout(lockApp, IDLE_LOCK_MS);
}
function pinDigit(d){
  if(pinBuffer.length>=4) return;
  pinError = false;
  pinBuffer += String(d);
  if(pinBuffer.length===4){
    const match = STAFF.find(s=>s.pin===pinBuffer);
    // Land on this staff member's own house by default (their only house for non-leadership roles,
    // since the picker stays locked for them) rather than whichever house the device was last left on.
    if(match){ state.userId = match.id; if(match.house && houses.some(h=>h.id===match.house)) state.house = match.house; pinBuffer=""; resetIdleTimer(); render(); }
    else { pinError = true; render(); setTimeout(()=>{ pinBuffer=""; pinError=false; render(); }, 500); }
  } else {
    render();
  }
}
function pinBackspace(){ pinBuffer = pinBuffer.slice(0,-1); pinError=false; render(); }
function renderLockScreen(){
  const overlay = document.getElementById("lockScreen");
  overlay.style.display = "flex";
  const dots = [0,1,2,3].map(i => `<span class="pin-dot ${i<pinBuffer.length?'filled':''} ${pinError?'error':''}"></span>`).join("");
  const keys = [1,2,3,4,5,6,7,8,9,"",0,"⌫"];
  overlay.innerHTML = `
    <div class="lock-card">
      <div class="brand" style="justify-content:center; margin-bottom:6px;">
        <div class="brand-mark">NH</div>
        <div class="brand-text" style="text-align:left;"><div class="top">New Horizon Homes</div><div class="sub">${houses[0].name} · House Dashboard</div></div>
      </div>
      <div class="lock-title">${pinError ? "PIN not recognized" : "Enter your 4-digit PIN"}</div>
      <div class="pin-dots">${dots}</div>
      <div class="pin-pad">
        ${keys.map(k=> k==="" ? `<span></span>` : k==="⌫" ? `<button class="pin-key pin-key-del" onclick="pinBackspace()">⌫</button>` : `<button class="pin-key" onclick="pinDigit(${k})">${k}</button>`).join("")}
      </div>
      <div class="lock-hint">Locks automatically when this tab isn't active, or after ${IDLE_LOCK_MS/60000} minutes idle — so it's always clear which caregiver documented what.</div>
    </div>`;
}
function hideLockScreen(){
  const overlay = document.getElementById("lockScreen");
  overlay.style.display = "none";
  overlay.innerHTML = "";
}

// Starts empty for the live pilot — real shift announcements get posted from the Dashboard once
// staff are using the house iPad.
let announcements = [];
let nextAnnId = 1;

function fmtWhen(d){
  return d.toLocaleString('en-US', {weekday:'short', month:'short', day:'numeric', hour:'numeric', minute:'2-digit'});
}
function expiresLabel(d){
  const hrs = (d - nowRef())/3600000;
  if(hrs<0) return "Expired";
  if(hrs<36) return `Expires ${fmtWhen(d)} · ~${Math.round(hrs)} hrs left`;
  return `Expires ${fmtWhen(d)}`;
}
function quickExtend(id,hours){
  const a = announcements.find(x=>x.id===id);
  if(!a) return;
  if(a.author !== currentUser().name) return; // only the original poster may extend
  a.expiresAt = new Date(a.expiresAt.getTime() + hours*3600000);
  const label = hours>=24 ? `${Math.round(hours/24)} day${hours>24?'s':''}` : `${hours} hrs`;
  a.history.push(`Extended by ${currentUser().name} — +${label}`);
  render();
}
function customExtend(id){
  const input = document.getElementById('customExtend-'+id);
  if(!input || !input.value) return;
  const a = announcements.find(x=>x.id===id);
  if(!a || a.author !== currentUser().name) return; // only the original poster may extend
  a.expiresAt = new Date(input.value);
  a.history.push(`Extended by ${currentUser().name} — set to ${fmtWhen(a.expiresAt)}`);
  render();
}
function toggleComposeCustom(){
  const dur = document.getElementById('announceDuration').value;
  document.getElementById('announceCustomWrap').style.display = dur==='custom' ? 'inline-flex' : 'none';
}
function postAnnouncement(){
  const msgEl = document.getElementById('announceMsg');
  const durEl = document.getElementById('announceDuration');
  const customEl = document.getElementById('announceCustom');
  const msg = msgEl.value.trim();
  if(!msg) return;
  const id = currentUser();
  let expiresAt;
  if(durEl.value==='custom'){
    expiresAt = customEl.value ? new Date(customEl.value) : new Date(nowRef().getTime()+24*3600000);
  } else {
    expiresAt = new Date(nowRef().getTime() + Number(durEl.value)*3600000);
  }
  announcements.unshift({ id:nextAnnId++, house: state.house, author:id.name, role:id.label, rail:id.rail, message:msg, postedAt:new Date(nowRef()), expiresAt, history:[] });
  msgEl.value = "";
