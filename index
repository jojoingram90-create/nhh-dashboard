function defaultDailyCare(){
  return {
    water:null,
    meals:{ breakfast:{pct:null}, lunch:{pct:null}, dinner:{pct:null} },
    medications:{}, // keyed by medLogKey(medId, anchor) -> { status:"pass"|"refuse", reason, by, initials, at }
    prn:{ given:null, reason:"", response:"" },
    vitals:{ monitored:null, types:{} },
    // "unusualNoted" gates the rest of the section — skin condition + nurse notified are only asked
    // (and meant to be filled in) once something unusual has actually been flagged, rather than every
    // resident needing a full skin assessment logged every single day regardless of whether there's
    // anything to report.
    skin:{ unusualNoted:null, status:[], nurseNotified:null, nurseNotifiedTime:"" },
    // Same "unusualNoted" gating pattern as skin, on top of the baseline bm/bmTime fact that's tracked
    // every day regardless. unusualType is an array (can be bowel, urination, or both) since a resident
    // can have something worth flagging in both on the same day.
    elimination:{ bm:null, bmTime:"", unusualNoted:null, unusualType:[], bowelIssue:null, bowelIssueOther:"", urinationIssue:null, urinationIssueOther:"", nurseNotified:null, nurseNotifiedTime:"", comments:"" },
    incident:{ occurred:null },
    general:{ overall:null, alertness:null, notes:"" },
    signoff:{ signedBy:null, signedRole:null, signedAt:null },
    meta:{}, // per-section { by, initials, at } — who last touched each section, and when
