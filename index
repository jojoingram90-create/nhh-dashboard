function findIRById(reportId){
  for(const rid in incidentReports){
    const found = (incidentReports[rid]||[]).find(x=>x.id===reportId);
    if(found) return found;
  }
  return null;
}
function irSectionKeyForPath(path){
  if(path.startsWith("info")) return "info";
  if(path==="types" || path==="typeOther") return "types";
  if(path==="description") return "description";
  if(path.startsWith("assessment")) return "assessment";
  if(path.startsWith("interventions") || path==="providerInstructions") return "interventions";
  if(path.startsWith("notifications")) return "notifications";
  if(path.startsWith("contributing")) return "contributing";
  if(path.startsWith("corrective") || path.startsWith("followUp")) return "corrective";
  if(path.startsWith("statements")) return "statements";
  if(path.startsWith("adminReview")) return "adminReview";
  return null;
