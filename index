function syncIRFormToState(reportId){
  const rep = findIRById(reportId);
  if(!rep) return;
  Object.keys(IR_TEXT_FIELDS).forEach(key=>{
    const el = document.getElementById("ir-"+key+"-"+reportId);
    if(el){
      const path = IR_TEXT_FIELDS[key];
      const parts = path.split(".");
      let cur = rep;
      for(let i=0;i<parts.length-1;i++){ if(cur[parts[i]]===undefined) return; cur = cur[parts[i]]; }
      cur[parts[parts.length-1]] = el.value;
