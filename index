function addDiagnosisTag(residentId){
  if(!moduleEdit('residents')) return;
  const el = document.getElementById("cp-newDiagnosis-"+residentId);
  const val = (el ? el.value : "").trim();
  if(!val) return;
  const cp = carePlans[residentId];
  if(!Array.isArray(cp.diagnosisTags)) cp.diagnosisTags = [];
  if(!cp.diagnosisTags.some(t=>t.toLowerCase()===val.toLowerCase())) cp.diagnosisTags.push(val);
  registerPendingDiagnosis(val);
  if(el) el.value = "";
  scheduleRender();
}

// Medications tab — repeating add/edit/remove list, separate from Care Plan because each row needs its
// own name/dosage/time-anchor editing rather than one shared field. Feeds Today's Flow and the Daily
// Care Log's Medications section automatically via medAnchorsForMed()/medsForAnchor().
function renderMedicationsTab(r){
  const cp = carePlans[r.id];
  const meds = cp.medications || [];
  const medRowRead = (med) => {
    const timesReadout = medAnchorsForMed(med).map(a=>`<span class="tag">${a.label}</span>`).join("") || "<span class='tag'>No times set</span>";
    return `<div class="cp-section">
        <div style="display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap;">
          <div><b>${esc(med.name)}</b>${med.dosage?` <span class="cp-hint" style="display:inline;">— ${esc(med.dosage)}</span>`:""}</div>
        </div>
        <div class="tag-list" style="margin-top:8px;">${timesReadout}</div>
      </div>`;
  };
  const medRowEdit = (med) => {
    const showOther = (med.times||[]).includes("other");
    return `<div class="cp-section">
      <div class="dc-inline-input" style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
        <label style="font-size:12.5px; color:var(--text-faint); flex:1; min-width:140px;">Medication<br>
          <input type="text" id="med-name-${r.id}-${med.id}" value="${esc(med.name)}" onchange="medFieldTouch('${r.id}')"></label>
        <label style="font-size:12.5px; color:var(--text-faint); flex:1; min-width:120px;">Dosage<br>
          <input type="text" id="med-dosage-${r.id}-${med.id}" value="${esc(med.dosage)}" onchange="medFieldTouch('${r.id}')"></label>
        <button class="btn small" onclick="removeMedication('${r.id}',${med.id})">Remove</button>
      </div>
      <div class="cp-hint" style="margin-top:10px; margin-bottom:5px;">Give at:</div>
      <div class="chip-row">${MEDICATION_TIME_OPTIONS.map(o=>{
        const active = (med.times||[]).includes(o.value);
        return `<button type="button" class="chip-btn ${active?'active':''}" onclick="medToggleTime('${r.id}',${med.id},'${o.value}')">${o.label}</button>`;
      }).join("")}</div>
      ${showOther ? `<div class="dc-inline-input"><label style="font-size:12.5px; color:var(--text-faint);">Specific time<br>
        <input type="time" id="med-otherTime-${r.id}-${med.id}" value="${esc(med.otherTime)}" onchange="medFieldTouch('${r.id}')"></label></div>` : ""}
    </div>`;
  };
  const readHtml = (meds.length ? meds.map(medRowRead).join("") : "<div class='comment-body' style='color:var(--text-faint)'>No medications on file.</div>");
  const editHtml = `
    ${meds.length ? meds.map(medRowEdit).join("") : "<div class='comment-body' style='color:var(--text-faint)'>No medications on file.</div>"}
    <div class="cp-section" style="border-bottom:none; padding-bottom:0;">
      <div class="dc-label">Add a medication</div>
      <div class="dc-inline-input" style="display:flex; gap:8px; flex-wrap:wrap;">
        <input type="text" id="med-newName-${r.id}" placeholder="Medication name" list="commonMedList" style="flex:1; min-width:140px;">
        <input type="text" id="med-newDosage-${r.id}" placeholder="Dosage (optional)" style="flex:1; min-width:120px;">
        <button class="btn small" onclick="addMedication('${r.id}')">Add</button>
      </div>
      <datalist id="commonMedList">${approvedCommonMedicationNames().map(n=>`<option value="${esc(n)}">`).join("")}</datalist>
      <div class="cp-hint" style="margin-top:6px;">Start typing to pick from medications already approved for New Horizon houses, or type a new one — it's usable right away and becomes a suggested option for everyone else once approved.</div>
    </div>`;
  return `<div class="card" style="padding:18px 20px;">
    <div class="section-head" style="margin-bottom:10px;">
      <h2 style="font-size:13.5px;">Medications</h2>
      <span class="hint">Shows up automatically in Today's Flow at the times selected below, with a Log Meds Pass/Refuse control, and on the Daily Care Log's Medications section.</span>
    </div>
    <div style="display:flex; justify-content:flex-end; margin-bottom:10px;"><button class="btn small" onclick="printMedicationsSheet('${r.id}')">🖨 Print</button></div>
    ${profileSection(r.id, "medicationsList", "Medications on file", editHtml, readHtml, null, !meds.length)}
  </div>`;
}

