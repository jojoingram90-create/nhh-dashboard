  state.calendarModal = { mode:"view", day, id };
  scheduleRender();
}
function closeCalendarModal(){
  state.calendarModal = null;
  scheduleRender();
}
// The "Type" chip row (Activity/Visit/Appointment) and, on the Add form, the Repeat picker all write
// straight onto state.calendarModal rather than being read from a <select> at save time — one shared
// set of setters covers add/edit/edit-series, since all three keep their draft on the same object.
function setCalendarModalKind(key){
  if(!state.calendarModal) return;
  syncCalendarModalFormToState(calendarModalIdSuffix());
  state.calendarModal.kind = key;
  scheduleRender();
}
function setCalendarModalRepeat(key){
  if(!state.calendarModal) return;
