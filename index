          ${plans.length ? plans.map(p=>renderBreakfastPlanRow(p)).join("") : `<div class="hint" style="font-style:italic;">No breakfast plans yet for ${resident?esc(resident.name):"this resident"} — their breakfast shows blank until one is added.</div>`}
        </div>
        ${moduleEdit('menu') ? `<div style="margin-top:14px;"><button class="btn primary small" onclick="startNewBreakfastPlan()">+ Add Breakfast Plan</button></div>` : ""}
        `}`}
