function openResident(id){ state.view="resident"; state.residentId=id; state.profileTab="overview"; render(); }
function openDailyCare(id){ state.view="dailycaredetail"; state.dcResidentId=id; state.dcViewDate=null; render(); }
// Prev/Next Day on a resident's Daily Care Log. Only ever moves state.dcViewDate — never past today,
// since a house's daily documentation obviously can't exist yet for a day that hasn't happened.
function shiftDailyCareDate(delta){
  const base = state.dcViewDate || todayIso();
  const next = addDaysIso(base, delta);
  if(next > todayIso()) return;
  state.dcViewDate = next === todayIso() ? null : next;
  scheduleRender();
}
function setProfileTab(t){ state.profileTab=t; render(); }
function toggleTask(key){
  const nowDone = !state.checked[key];
  state.checked[key] = nowDone;
  if(nowDone) state.completedBy[key] = currentUser().name;
  else delete state.completedBy[key];
  scheduleRender();
}

