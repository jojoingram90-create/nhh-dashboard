  const day = document.getElementById("cal-day-new").value;
  const title = document.getElementById("cal-title-new").value.trim();
  const time = document.getElementById("cal-time-new").value.trim();
  const notes = document.getElementById("cal-notes-new").value.trim();
  const kind = m.kind || "activity";
  if(!title || !time) return;
  const repeat = m.repeat || "none";
  if(repeat === "none"){
    if(!calendarEvents[day]) calendarEvents[day] = [];
    calendarEvents[day].push(ce(calendarEventIdSeq++, title, kind, time, notes, currentUser().name, "Just now"));
  } else {
    if((repeat==="weekly"||repeat==="biweekly") && !(m.repeatDays||[]).length){
      m.repeatError = "Pick at least one day of the week.";
      scheduleRender();
      return;
    }
    const windowMonths = m.windowMonths || 1;
    const series = {
      id: calendarSeriesIdSeq++, title, kind, time, notes, house: state.house,
      repeat, repeatDays: (m.repeatDays||[]).slice(),
      startDay: day, windowMonths,
      generatedThrough: addMonthsIso(day, windowMonths),
      status: "active", createdBy: currentUser().name, createdAt: "Just now"
    };
