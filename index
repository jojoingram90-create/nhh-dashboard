      <button type="button" class="card stat-tile" style="text-align:left;" onclick="toggleDashboardStatFilter('hospice')"><div class="n tabular" style="color:var(--hospice-dot)">${hospiceCount}</div><div class="l">Hospice</div></button>
      <button type="button" class="card stat-tile" style="text-align:left;" onclick="toggleDashboardStatFilter('away')"><div class="n tabular" style="color:var(--away-dot)">${awayCount}</div><div class="l">Out of building</div></button>
    </div>
    ${state.dashboardStatFilter ? renderDashboardStatList(state.dashboardStatFilter) : ""}
  </div>

  ${renderShiftFeed()}

  ${renderTodayEvents()}

  <div class="section">
    ${renderTodaysFlow()}
  </div>`;
  document.getElementById("content").innerHTML = html;
}

// Today's Flow is one merged, time-sorted list — wake-ups, showers, meals, scheduled routines, and
// bedtimes for every resident, interleaved by actual clock time rather than grouped into fixed
// category sections. See todaysFlowRows() for how each row gets its time.
function renderTodaysFlow(){
  const rows = todaysFlowRows();
  const now = nowTimeStr();
  const currentBucketKey = flowBucketFor(now).key;

  // Lazy-init: only the bucket matching the real current time starts expanded. Set once, then left
  // alone across re-renders so a manager's manual expand/collapse choices persist while checking things off.
  if(state.flowExpandedBuckets === null){
    state.flowExpandedBuckets = { [currentBucketKey]: true };
  }

  const byBucket = {};
  FLOW_BUCKETS.forEach(b=>{ byBucket[b.key] = []; });
  rows.forEach(row=>{ byBucket[flowBucketFor(row.time).key].push(row); });

  const nonEmptyBuckets = FLOW_BUCKETS.filter(b=>byBucket[b.key].length>0);

  const bucketsHtml = nonEmptyBuckets.map(b=>{
    const bucketRows = byBucket[b.key];
    const pending = bucketRows.filter(r=>!isFlowRowDone(r));
    const completed = bucketRows.filter(isFlowRowDone);
    const expanded = !!state.flowExpandedBuckets[b.key];
    const isCurrent = b.key === currentBucketKey;

    let innerHtml;
    if(pending.length===0){
      innerHtml = `<div class="task-row" style="border-top:none;"><div class="task-row-desc" style="font-style:italic;">${b.label} tasks complete.</div></div>`;
    } else {
      let markerPlaced = !isCurrent; // the Now divider only ever falls inside the current-time bucket
      innerHtml = pending.map(row=>{
        let out = "";
        const isNext = !markerPlaced && row.time && row.time >= now;
        if(isNext){
          out += `<div class="flow-now-marker"><span>Now — ${formatTime12(now)}</span></div>`;
          markerPlaced = true;
        }
        out += renderFlowRow(row, isNext);
        return out;
      }).join("");
      if(isCurrent && !markerPlaced) innerHtml += `<div class="flow-now-marker"><span>Now — ${formatTime12(now)}</span></div>`;
    }

    const completedHtml = completed.length ? `
      <div class="flow-completed-toggle" onclick="toggleBucketCompleted('${b.key}')">${state.flowBucketShowCompleted[b.key] ? "▾" : "▸"} ✓ ${completed.length} completed</div>
      ${state.flowBucketShowCompleted[b.key] ? completed.map(r=>renderFlowRow(r,false)).join("") : ""}` : "";

    return `
    <div class="flow-bucket">
      <button class="flow-bucket-toggle" onclick="toggleFlowBucket('${b.key}')">
        <span class="flow-bucket-caret">${expanded ? "▾" : "▸"}</span>
        <span class="flow-bucket-label">${b.label}</span>
        ${isCurrent ? `<span class="flow-bucket-now-pill">Now</span>` : ""}
        <span class="flow-bucket-count">${completed.length}/${bucketRows.length}</span>
      </button>
      ${expanded ? `<div class="flow-bucket-body">${innerHtml}${completedHtml}</div>` : ""}
    </div>`;
  }).join("");

  return `
  <div class="card flow-block">
    <div class="flow-head"><h3>Today's Flow</h3></div>
    ${nonEmptyBuckets.length ? bucketsHtml : `<div class="task-row" style="border-top:none;"><div class="task-row-desc" style="font-style:italic;">Nothing scheduled for today.</div></div>`}
  </div>`;
}

// Each of the five time-of-day windows Johnna set (Overnight/Morning/Midday/Evening/Night). Only the
// one containing the real current clock time starts expanded; the rest collapse to a one-line header
// a manager can tap open. "before" is the exclusive upper bound of the window, compared as "HH:MM".
const FLOW_BUCKETS = [
  { key:"overnight", label:"Overnight", before:"05:00" },
  { key:"morning",   label:"Morning",   before:"11:00" },
  { key:"midday",    label:"Midday",    before:"16:00" },
  { key:"evening",   label:"Evening",   before:"19:00" },
  { key:"night",     label:"Night",     before:"24:00" }
];
function flowBucketFor(time){
  const t = time || "23:59";
  for(const b of FLOW_BUCKETS) if(t < b.before) return b;
  return FLOW_BUCKETS[FLOW_BUCKETS.length-1];
}
function nowTimeStr(){
  const d = new Date();
  return String(d.getHours()).padStart(2,"0")+":"+String(d.getMinutes()).padStart(2,"0");
}
function toggleFlowBucket(key){
  state.flowExpandedBuckets[key] = !state.flowExpandedBuckets[key];
  scheduleRender();
}
function toggleBucketCompleted(key){
  state.flowBucketShowCompleted[key] = !state.flowBucketShowCompleted[key];
  scheduleRender();
}

// Builds the merged row list: wake-ups and bedtimes (from carePlans wake/bedTime), showers
// (from carePlans hygiene, filtered to residents scheduled today), one grouped row per standard
// mealtime (breakfast/lunch/dinner — see below), and Scheduled Routines (already time-stamped).
// Every row shares one clock-time sort key, used both for the flat sort and for bucketing.
const MEAL_META = {
  breakfast: { icon:"🍳", label:"Breakfast" },
  lunch:     { icon:"🍛", label:"Lunch" },
  dinner:    { icon:"🥪", label:"Dinner" }
};
function todaysFlowRows(){
  const rows = [];

  // Wake-Up and Bedtime are grouped exactly like meals below: residents on the house-standard time
  // nest under one collapsible row, and a resident with a different Care Plan time gets a badge inside
  // it rather than a whole separate row scattered elsewhere in the list.
  const wakeMembers = wakeUpRows().map(row=>({ residentId:row.residentId, who:row.who, detail:row.detail, time:row.time, customTime: row.time !== houseWakeBedTimes.wake }));
  if(wakeMembers.length){
    rows.push({ key:"wakegroup", time:houseWakeBedTimes.wake, icon:"☀️", label:"Wake-Up", kind:"wakegroup", groupKey:"wake", members:wakeMembers, typeKey:"wake" });
  }

  houseResidents().forEach(r=>{
    const cp = carePlans[r.id];
    if(cp.hygiene.mode==="shower" && cp.hygiene.days.includes(TODAY_DOW)){
      const detail = `${esc(cp.hygiene.shift)} shift shower${cp.hygiene.notes?` — ${esc(cp.hygiene.notes)}`:""}.`;
      rows.push({ key:`shower-${r.id}`, time:cp.hygiene.timeOfDay, icon:"🚿", label:"Shower", who:r.name, detail, kind:"simple", typeKey:"shower" });
    }
  });

  // Residents on the house-standard mealtime nest under one collapsible group row rather than each
  // appearing as their own row; a resident with a Care-Plan meal-time override still shows inside the
  // group (grouped by meal, not by exact time) but carries its own "different time" badge — see
  // renderMealMemberRow().
  Object.keys(MEAL_META).forEach(mealKey=>{
    const meta = MEAL_META[mealKey];
    const members = (dailyTasks[mealKey]||[]).map(row=>{
      const time = effectiveMealTime(row.id, mealKey);
      return { residentId:row.id, who:row.who, detail:row.detail, time, customTime: time !== currentHouseMealTimes()[mealKey] };
    });
    if(members.length){
      rows.push({ key:`mealgroup-${mealKey}`, time:currentHouseMealTimes()[mealKey], icon:meta.icon, label:meta.label, kind:"mealgroup", mealKey, members, typeKey:mealKey });
    }
  });

  scheduledRoutinesRows().forEach(({resident:r, item})=>{
    rows.push({ key:`sched${item.id}`, time:item.time, icon:"⏰", label:"Routine", who:r.name, kind:"routine", item, resident:r, typeKey:"routine" });
  });

  const bedMembers = bedtimeRows().map(row=>({ residentId:row.residentId, who:row.who, detail:row.detail, time:row.time, customTime: row.time !== houseWakeBedTimes.bed }));
  if(bedMembers.length){
    rows.push({ key:"bedgroup", time:houseWakeBedTimes.bed, icon:"🌙", label:"Bedtime", kind:"bedgroup", groupKey:"bed", members:bedMembers, typeKey:"bedtime" });
  }

  // Medications tied to one of the five standard anchors (wake/breakfast/lunch/dinner/bedtime) don't get
  // their own row — they ride the matching group row above and surface via a "Log Meds" control on each
  // resident's member row (see medFlowBlock()). Only "Other" custom-time medications need a standalone
  // row here, grouped per resident+exact-time so several other-time meds due together log in one place.
  medOtherRows().forEach(g=>{
    rows.push({ key:`medother-${g.residentId}-${g.anchor}`, time:g.time, icon:"💊", label:"Medication", who:g.who, kind:"medother", meds:g.meds, residentId:g.residentId, anchor:g.anchor, typeKey:"medication" });
  });

  rows.sort((a,b)=> (a.time||"99:99").localeCompare(b.time||"99:99"));
  return rows;
}
// Groups every resident's "Other"-time medications by exact clock time so Today's Flow shows one row
// per resident per custom time, however many medications share that time.
function medOtherRows(){
  const groups = {};
  houseResidents().forEach(r=>{
    (carePlans[r.id].medications||[]).forEach(med=>{
      medAnchorsForMed(med).filter(a=>a.anchor.startsWith("other-")).forEach(a=>{
        const gKey = r.id+"|"+a.anchor;
        if(!groups[gKey]) groups[gKey] = { residentId:r.id, who:r.name, time:a.time, anchor:a.anchor, meds:[] };
        groups[gKey].meds.push(med);
      });
    });
  });
  return Object.values(groups);
}
const GROUP_KINDS = ["mealgroup","wakegroup","bedgroup"];
// The per-resident checkbox key inside any group row — kept identical to what a standalone row would
// have used (e.g. "wake-eleanor"), so nothing about existing checked-state keys had to change.
function groupMemberKey(row, m){
  if(row.kind === "mealgroup") return `${row.mealKey}-${m.residentId}`;
  return `${row.groupKey}-${m.residentId}`;
}
// A group counts as done once every resident inside it has been checked off — except a meal group,
// which now counts a resident as done once their % eaten has actually been logged (Meals Eaten no
// longer has its own separate checkbox — see renderMealMemberRow). Wake-Up/Bedtime groups are
// unchanged, still plain per-resident checkboxes.
function isFlowRowDone(row){
  if(row.kind === "mealgroup") return row.members.length>0 && row.members.every(m=>!!getDC(m.residentId).meals[row.mealKey].pct);
  if(GROUP_KINDS.includes(row.kind)) return row.members.length>0 && row.members.every(m=>!!state.checked[groupMemberKey(row,m)]);
  // Medications (standalone "Other"-time row) — done once every due medication has a recorded status,
  // same fact medFlowBlock's own badge already shows. No checkbox anymore; logging is the completion.
  if(row.kind === "medother"){
    const dc = getDC(row.residentId);
    return row.meds.length>0 && row.meds.every(med=>!!(dc.medications||{})[medLogKey(med.id, row.anchor)]);
  }
  // A vital-type Routine task is done once it's actually been logged; a PRN-type Routine task keeps
  // its own checkbox as before.
  if(row.kind === "routine" && row.item.type === "vital") return !!row.item.loggedAt;
  return !!state.checked[row.key];
}

// Long descriptions truncate to one line with a "Show more" toggle rather than stretching the row —
// the toggle flips two plain-text spans via the [hidden] attribute, no re-render needed.
const DESC_TRUNCATE_LEN = 70;
function renderRowDescription(icon, label, fullText){
  const text = fullText || "";
  const isLong = text.length > DESC_TRUNCATE_LEN;
  let shortText = text;
  if(isLong){
    shortText = text.slice(0, DESC_TRUNCATE_LEN);
    const lastSpace = shortText.lastIndexOf(" ");
    if(lastSpace > 40) shortText = shortText.slice(0, lastSpace);
    shortText += "…";
  }
  return `<div class="task-row-desc">
    <span class="flow-tag" title="${esc(label)}">${icon}</span>
    <span class="desc-text"><span class="desc-short">${esc(shortText)}</span><span class="desc-full" hidden>${esc(text)}</span></span>
    ${isLong ? `<button class="show-more-btn" onclick="toggleDescMore(this)">Show more</button>` : ""}
  </div>`;
}
function toggleDescMore(btn){
  const wrap = btn.previousElementSibling;
  const shortEl = wrap.querySelector(".desc-short");
  const fullEl = wrap.querySelector(".desc-full");
  const expand = fullEl.hidden;
  fullEl.hidden = !expand;
  shortEl.hidden = expand;
  btn.textContent = expand ? "Show less" : "Show more";
}

function vitalValueDisplay(vt, existing){
  if(!existing) return "";
  if(vt.key==="bp") return (existing.sys || existing.dia) ? `${esc(existing.sys)}/${esc(existing.dia)}` : "";
  if(vt.key==="pain") return existing.rating ? `${esc(existing.rating)}/10${existing.location?` · ${esc(existing.location)}`:""}` : "";
  return existing.value ? esc(existing.value) : "";
}

function renderFlowRow(row, isNext){
  const nextCls = isNext ? " flow-row-current" : "";
  if(row.kind === "mealgroup") return renderMealGroupRow(row, isNext);
  if(row.kind === "wakegroup" || row.kind === "bedgroup") return renderWakeBedGroupRow(row, isNext);
  if(row.kind === "medother") return renderMedOtherRow(row, isNext);

  if(row.kind === "routine"){
    const r = row.resident, item = row.item;
    const key = row.key;
    const isVital = item.type === "vital";
    // A vital-type routine task has no checkbox — logging its value IS what marks it done (see
    // isFlowRowDone). A PRN-type routine task is unchanged, still a plain checkbox.
    const done = isVital ? !!item.loggedAt : !!state.checked[key];
    const canQuickLog = routineCorrelatesToDailyCare(item.type);
    const expanded = state.expandedRoutineId === item.id;
    const fullDetail = `${routineTypeLabel(item)}${item.detail?` — ${esc(item.detail)}`:""}`;
    const vt = isVital ? (VITAL_TYPES.find(v=>v.key===item.vitalType) || VITAL_TYPES[0]) : null;
    let loggedSummary = "";
    if(canQuickLog && item.loggedAt){
      const dc = getDC(r.id);
      if(isVital){
        const value = vitalValueDisplay(vt, dc.vitals.types[vt.key]);
        loggedSummary = `${vt.label}${value ? `: ${value}` : ""}`;
      } else if(item.type==="prn"){
        loggedSummary = `PRN given${dc.prn.reason ? ` — ${esc(dc.prn.reason)}` : ""}`;
      }
    }
    return `
      <div class="task-row routine-row ${done?'done':''}${nextCls}" data-type="routine">
        ${isVital ? "" : `<input type="checkbox" ${done?'checked':''} onchange="toggleTask('${key}')">`}
        <div class="task-row-headline">
          <div class="who">${formatTime12(item.time)} — ${r.name}</div>
          ${renderRowDescription(row.icon, "Routine", fullDetail)}
          <div class="added-by">Added by ${item.addedBy}</div>
        </div>
        <div class="task-row-actions">
          ${canQuickLog ? (item.loggedAt
            ? `<div class="dc-stamp-editable"><span class="dc-stamp">${loggedSummary} ✓</span><button class="btn small" onclick="toggleRoutineQuickLog(${item.id})">✎ Edit</button></div>`
            : (isVital
                ? `<button class="btn primary task-log-btn" onclick="toggleRoutineQuickLog(${item.id})">${esc(vt.label)}</button>`
                : `<button class="btn small" onclick="toggleRoutineQuickLog(${item.id})">Log PRN</button>`)) : ""}
        </div>
      </div>
      ${expanded ? routineQuickLogForm(r, item) : ""}`;
  }

  const done = !!state.checked[row.key];
  const timeLabel = row.time ? `${formatTime12(row.time)} — ` : "";
  return `<div class="task-row ${done?'done':''}${nextCls}" data-type="${row.typeKey}">
    <input type="checkbox" ${done?'checked':''} onchange="toggleTask('${row.key}')">
    <div class="task-row-headline">
      <div class="who">${timeLabel}${row.who}</div>
      ${renderRowDescription(row.icon, row.label, row.detail)}
    </div>
    <div class="task-row-actions">${done && state.completedBy[row.key] ? `<span class="staff">✓ ${state.completedBy[row.key]}</span>` : ""}</div>
  </div>`;
}

// A meal group is a collapsible header (no checkbox of its own — completion is tracked per resident
// inside it) that expands to one row per resident sharing that mealtime, each with its own % Eaten
// quick-log. See isFlowRowDone() for how the group as a whole counts as complete.
function renderMealGroupRow(row, isNext){
  const nextCls = isNext ? " flow-row-current" : "";
  const groupKey = `meal-${row.mealKey}`;
  const expanded = !!state.expandedGroups[groupKey];
  const doneCount = row.members.filter(m=>!!getDC(m.residentId).meals[row.mealKey].pct).length;
  const total = row.members.length;
  const allDone = doneCount === total;
  const timeLabel = row.time ? `${formatTime12(row.time)} — ` : "";
  return `
  <div class="task-row mealgroup-row ${allDone?'done':''}${nextCls}" data-type="${row.typeKey}" onclick="toggleFlowGroup('${groupKey}')" role="button" tabindex="0" onkeydown="if(event.key==='Enter')toggleFlowGroup('${groupKey}')">
    <span class="mealgroup-caret">${expanded ? "▾" : "▸"}</span>
    <div class="task-row-headline">
      <div class="who">${timeLabel}${row.label} <span class="hint" style="font-weight:600;">— all residents</span></div>
      ${renderRowDescription(row.icon, row.label, `Tap to ${expanded ? "collapse" : "expand"} and log each resident's intake.`)}
    </div>
    <div class="task-row-actions"><span class="mealgroup-count-pill">${doneCount}/${total} logged</span></div>
  </div>
  ${expanded ? `<div class="mealgroup-members">${row.members.map(m=>renderMealMemberRow(row,m)).join("")}</div>` : ""}`;
}
// Wake-Up / Bedtime groups use the same collapsible-header pattern as a meal group, but members are
// a plain checkbox (no % Eaten quick-log) — see renderWakeBedMemberRow().
function renderWakeBedGroupRow(row, isNext){
  const nextCls = isNext ? " flow-row-current" : "";
  const expanded = !!state.expandedGroups[row.groupKey];
  const doneCount = row.members.filter(m=>!!state.checked[groupMemberKey(row,m)]).length;
  const total = row.members.length;
  const allDone = doneCount === total;
  // No shared group-level time shown here anymore — every resident can have their own wake/bed time on
  // their Care Plan, so a single time next to "Wake-Up"/"Bedtime" was misleading. Each resident's own
  // time still shows once the group is expanded — see renderWakeBedMemberRow().
  return `
  <div class="task-row mealgroup-row ${allDone?'done':''}${nextCls}" data-type="${row.typeKey}" onclick="toggleFlowGroup('${row.groupKey}')" role="button" tabindex="0" onkeydown="if(event.key==='Enter')toggleFlowGroup('${row.groupKey}')">
    <span class="mealgroup-caret">${expanded ? "▾" : "▸"}</span>
    <div class="task-row-headline">
      <div class="who">${row.label} <span class="hint" style="font-weight:600;">— all residents</span></div>
      ${renderRowDescription(row.icon, row.label, `Tap to ${expanded ? "collapse" : "expand"} and check off each resident.`)}
    </div>
    <div class="task-row-actions"><span class="mealgroup-count-pill">${doneCount}/${total} done</span></div>
  </div>
  ${expanded ? `<div class="mealgroup-members">${row.members.map(m=>renderWakeBedMemberRow(row,m)).join("")}</div>` : ""}`;
}
function renderWakeBedMemberRow(row, m){
  const key = groupMemberKey(row, m);
  const done = !!state.checked[key];
  // Always shows this resident's own time (falling back to the 7:00 AM/PM display default when nothing's
  // on file — see formatWakeBedTime12) — the group header above no longer carries a shared time, so this
  // is the only place a resident's wake/bed time appears in Today's Flow.
  const timeBadge = `<span class="custom-time-badge">🕐 ${formatWakeBedTime12(m.time, row.groupKey)}</span>`;
  const medAnchor = row.groupKey === "bed" ? "bedtime" : "wake";
  const dueMeds = medsForAnchor(m.residentId, medAnchor);
  const medBlock = medFlowBlock(m.residentId, medAnchor, dueMeds);
  return `
  <div class="task-row meal-member-row ${done?'done':''}" data-type="${row.typeKey}" onclick="event.stopPropagation()">
    <input type="checkbox" ${done?'checked':''} onchange="toggleTask('${key}')">
    <div class="task-row-headline">
      <div class="who">${m.who}${timeBadge}</div>
      ${renderRowDescription(row.icon, row.label, m.detail)}
    </div>
    <div class="task-row-actions">
      ${done && state.completedBy[key] ? `<span class="staff">✓ ${state.completedBy[key]}</span>` : ""}
      ${medBlock.button}
    </div>
  </div>
  ${medBlock.panel}`;
}
function toggleFlowGroup(groupKey){
  state.expandedGroups[groupKey] = !state.expandedGroups[groupKey];
  scheduleRender();
}
// Meals Eaten has no checkbox of its own anymore — tapping the big % eaten button (or, once logged,
// the stamp showing what was logged) is both how it's recorded AND what marks it done; see
// isFlowRowDone for the mealgroup completion check this drives.
function renderMealMemberRow(row, m){
  const key = `${row.mealKey}-${m.residentId}`;
  const dc = getDC(m.residentId);
  const pct = dc.meals[row.mealKey].pct;
  const pctLabel = pct ? (MEAL_PCT.find(o=>o.value===pct)||{}).label : null;
  const mealExpanded = state.expandedMealKey === key;
  const timeBadge = m.customTime ? `<span class="custom-time-badge" title="This resident's ${row.label.toLowerCase()} time is set individually in their Care Plan">🕐 ${formatTime12(m.time)}</span>` : "";
  const dueMeds = medsForAnchor(m.residentId, row.mealKey);
  const medBlock = medFlowBlock(m.residentId, row.mealKey, dueMeds);
  return `
  <div class="task-row meal-member-row ${pct?'done':''}" data-type="${row.typeKey}" onclick="event.stopPropagation()">
    <div class="task-row-headline">
      <div class="who">${m.who}${timeBadge}</div>
      ${renderRowDescription(row.icon, row.label, m.detail)}
    </div>
    <div class="task-row-actions">
      ${pct
        ? `<div class="dc-stamp-editable"><span class="dc-stamp">${pctLabel} eaten ✓</span><button class="btn small" onclick="toggleMealQuickLog('${key}')">✎ Edit</button></div>`
        : `<button class="btn primary task-log-btn" onclick="toggleMealQuickLog('${key}')">Log % Eaten</button>`}
      ${medBlock.button}
    </div>
  </div>
  ${mealExpanded ? mealQuickLogForm(row.mealKey, m.residentId, key) : ""}
  ${medBlock.panel}`;
}
function toggleMealQuickLog(key){
  state.expandedMealKey = state.expandedMealKey===key ? null : key;
  scheduleRender();
}
// One tap on a % option logs it immediately and closes the panel — no separate Save step, since
// there's nothing to type or double-check here the way there is for a vital's value.
function mealQuickLogForm(mealKey, residentId, key){
  const dc = getDC(residentId);
  const pct = dc.meals[mealKey].pct;
  return `<div class="card routine-quicklog" onclick="event.stopPropagation()">
    <div class="dc-label">% eaten — writes to Daily Care</div>
    <div class="task-log-options">
      ${MEAL_PCT.filter(o=>o.value!=="na").map(o=>`<button type="button" class="task-log-opt ${pct===o.value?'active':''}" onclick="instantLogMealPct('${residentId}','${mealKey}','${key}','${o.value}')">${o.label}</button>`).join("")}
    </div>
    <div class="routine-quicklog-actions">
      <button class="btn small" onclick="toggleMealQuickLog('${key}')">Close</button>
    </div>
  </div>`;
}
function instantLogMealPct(residentId, mealKey, key, value){
  quickLogMealPct(residentId, mealKey, value);
