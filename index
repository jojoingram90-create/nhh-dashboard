function saveBreakfastPlan(){
  const d = state.breakfastPlanDraft; if(!d) return;
  const residentId = state.breakfastPrefsResidentId;
  if(!d.items.length && !d.customItems.length){
    state.breakfastPlanFormError = "Select or write in at least one item.";
    scheduleRender();
    return;
  }
  if(d.scope==="days" && !d.days.length){
    state.breakfastPlanFormError = "Choose at least one day, or switch to Every day.";
    scheduleRender();
    return;
  }
  if(d.scope==="all" && breakfastDaysTakenByOtherPlans(residentId, d.id).size){
    state.breakfastPlanFormError = "This resident already has another breakfast plan covering part of the week — remove or narrow it first, or choose Specific days instead.";
    scheduleRender();
    return;
  }
  const plans = residentBreakfastPlansFor(residentId);
  if(d.id === null){
    plans.push({ id: breakfastPlanIdSeq++, label:d.label, items:d.items, customItems:d.customItems, scope:d.scope, days:d.days });
  } else {
    const idx = plans.findIndex(p=>p.id===d.id);
    if(idx>=0) plans[idx] = { id:d.id, label:d.label, items:d.items, customItems:d.customItems, scope:d.scope, days:d.days };
  }
  state.breakfastPlanEditingId = null;
  state.breakfastPlanDraft = null;
  state.breakfastPlanFormError = null;
  scheduleRender();
}
