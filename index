/* ---------------- Supplies Received ----------------
   A simple per-resident log: what was received, the date, an optional quantity, and an optional note.
   Gated by its own "supplies" module permission (see MODULES) exactly like every other nav section —
   view-only staff see the list, edit-tier staff also get the add/edit/remove controls.
   Logging starts with quick-tap item buttons rather than typing — see SUPPLY_QUICK_ITEMS/
   SUPPLY_TOILETRY_ITEMS and renderSuppliesAddForm() below. Whatever ends up in the write-in box (at
   either level) is usable and saved immediately, same as a quick-picked item — none of this needs
   Leadership approval, unlike a new medication or diagnosis name. */
const SUPPLY_QUICK_ITEMS = ["Diapers","Wipes","Gloves","Toiletries"];
const SUPPLY_TOILETRY_ITEMS = ["Shampoo","Conditioner","Lotion","Toothpaste","Toothbrush"];
function houseSuppliesReceived(){
  const ids = new Set(houseResidents().map(r=>r.id));
  return suppliesReceived.filter(s=>ids.has(s.residentId)).slice().sort((a,b)=>{
    if(a.dateReceived !== b.dateReceived) return (b.dateReceived||"").localeCompare(a.dateReceived||"");
    return b.id - a.id;
  });
}
// Applies the date/resident filter from item 39 on top of the house-scoped, newest-first list above.
function filteredSuppliesReceived(){
  return houseSuppliesReceived().filter(s=>{
    if(state.suppliesFilterResidentId && s.residentId !== state.suppliesFilterResidentId) return false;
    if(state.suppliesFilterDate && s.dateReceived !== state.suppliesFilterDate) return false;
    return true;
  });
}
function setSuppliesFilterResident(id){ state.suppliesFilterResidentId = id; scheduleRender(); }
function setSuppliesFilterDate(d){ state.suppliesFilterDate = d; scheduleRender(); }
function clearSuppliesFilters(){ state.suppliesFilterResidentId=""; state.suppliesFilterDate=""; scheduleRender(); }
function toggleSuppliesAdd(){
  if(!moduleEdit('supplies')) return;
  state.suppliesAddOpen = !state.suppliesAddOpen;
  if(state.suppliesAddOpen){
    const list = houseResidents();
    state.suppliesDraft = { residentId: list.length ? list[0].id : "", item:"", quantity:"", dateReceived: todayIso(), notes:"", showToiletries:false, writeInOpen:false };
  }
  state.suppliesAddError = null;
  scheduleRender();
}
// The quick-pick flow: tapping a top-level item (Diapers/Wipes/Gloves) sets it directly; Toiletries
// opens its own second row of quick options instead of setting an item itself; either level's
// "write in an item" opens a free-text box whose value is used exactly as typed, no approval needed.
