function computeInitials(name){
  const parts = (name||"").trim().split(/\s+/).filter(Boolean);
  if(!parts.length) return "?";
  if(parts.length===1) return parts[0].slice(0,2).toUpperCase();
  return (parts[0][0] + parts[parts.length-1][0]).toUpperCase();
}
function slugifyStaffId(name){
  const base = (name||"").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/(^-|-$)/g,"") || "staff";
  let id = base, n = 2;
  while(STAFF.some(s=>s.id===id)){ id = base+"-"+n; n++; }
  return id;
}
function isLastLeadership(staff){ return staff.role==="leadership" && STAFF.filter(s=>s.role==="leadership").length<=1; }

