function slugifyHouseContactId(name){
  const base = (name||"").toLowerCase().trim().replace(/[^a-z0-9]+/g,"-").replace(/(^-|-$)/g,"") || "contact";
  let id = base, n = 2;
  while(houseContacts.some(c=>c.id===id)){ id = `${base}-${n++}`; }
  return id;
}
