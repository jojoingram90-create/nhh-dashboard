// fixed list — a module set to "none" (see Manage Staff) just doesn't appear. Pending Approvals and
// Manage Staff aren't part of the configurable module list at all: Pending Approvals piggybacks on the
// same permission as approving/deleting meal notes (moduleEdit('menu')), and Manage Staff is gated to
// isSystemAdmin() only, never to a configurable permission — see the notes on both above.
function visibleNavItems(){
  const items = NAV.filter(n => moduleView(n.id));
  if(moduleEdit('menu') || moduleEdit('residents')){
    let pending = 0;
    if(moduleEdit('menu')) pending += housePendingMealNotes().length;
    if(moduleEdit('residents')) pending += pendingCommonMedications().length;
    items.push({ id:"approvals", label:"Pending Approvals", icon:"✔", badge: pending || null });
  }
  // Manage Residents no longer has its own nav row — it's reached via a button at the top of the
  // Residents page itself (see renderResidents()), though the view/route it lands on is unchanged.
  if(isSystemAdmin()){
    items.push({ id:"staff", label:"Manage Staff", icon:"⚙" });
    items.push({ id:"houses", label:"Manage Houses", icon:"⌂" });
  }
  return groupNavItems(items);
}
