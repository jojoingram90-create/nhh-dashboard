function formatTime12(t){
  // Guards against a blank/invalid time (e.g. a resident whose Care Plan wake/bed/shower time was never
  // filled in) — without this, "".split(":") silently parses as hour 0, minute undefined, producing the
  // nonsense "12:undefined AM" instead of a clear "Not set".
  if(!t || !/^\d{1,2}:\d{2}$/.test(t)) return "Not set";
  const [h,m] = t.split(":").map(Number);
  const ap = h>=12 ? "PM" : "AM";
  const h12 = ((h+11)%12)+1;
  return `${h12}:${String(m).padStart(2,"0")} ${ap}`;
}
// Wake/bed times specifically default to a display-only 7:00 AM / 7:00 PM when nothing's on file yet,
// rather than the generic "Not set" every other blank time in the app shows (meal times, hygiene time,
// etc. are unaffected — they still fall through to formatTime12's plain "Not set"). This is purely a
// display fallback: it never writes 07:00/19:00 into a resident's actual Care Plan data, so a manager
// opening Edit on a resident who's never had a wake/bed time entered still sees a genuinely blank field,
// not a pre-filled one. Used everywhere a resident's wake or bed time is shown — Today's Flow and the
// Care Plan tab alike — so the same resident never shows "Not set" in one place and 7:00 in another.
function formatWakeBedTime12(t, kind){
  if(t && /^\d{1,2}:\d{2}$/.test(t)) return formatTime12(t);
  return kind === "bed" ? "7:00 PM" : "7:00 AM";
}
// Calendar event time is now entered via a native 24-hour "HH:MM" time picker (see eventFormFields),
// but events saved before that change may still hold the old free-typed display string (e.g. "2:00
// PM"). This formats the new 24-hour value normally and falls back to showing an old value exactly as
// stored, rather than letting formatTime12 choke on it.
function fmtEventTime(t){
  if(!t) return "";
  if(/^\d{1,2}:\d{2}$/.test(t)) return formatTime12(t);
  return t;
}
