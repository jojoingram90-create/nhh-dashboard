  // multi-select tags (see DIAGNOSIS_TAGS/registerPendingDiagnosis) — keeps any diagnosis already on
  // file from an earlier version of the app instead of silently dropping it.
  if(!Array.isArray(cp.diagnosisTags)){
    cp.diagnosisTags = cp.diagnosis ? [cp.diagnosis] : [];
    cp.diagnosisDetails = cp.diagnosisDetails || "";
