function requestRemoveHouse(houseId){
  if(!isSystemAdmin()) return;
  state.houseRemoveBlocked = null;
  if(houses.length<=1){ state.houseRemoveBlocked = { houseId, message:"This is the only house — add another before removing this one." }; scheduleRender(); return; }
  if(residents.some(r=>r.house===houseId)){ state.houseRemoveBlocked = { houseId, message:"This house still has residents on file — move or remove them first (Manage Residents)." }; scheduleRender(); return; }
  if(STAFF.some(s=>s.house===houseId)){ state.houseRemoveBlocked = { houseId, message:"This house still has staff assigned to it — reassign them to another house first (Manage Staff)." }; scheduleRender(); return; }
  state.houseRemovePending = houseId;
  scheduleRender();
}
function cancelRemoveHouse(){
  state.houseRemovePending = null;
  state.houseRemoveBlocked = null;
