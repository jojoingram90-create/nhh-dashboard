// Editing can also move an event to a different day — the record is spliced out of its old day's array
// and pushed into the new one, keeping its id, creator, and history intact. This only ever touches the
// one occurrence being viewed — see saveEventEditSeries() for "whole series" edits.
function saveEventEdit(day, id){
  if(!moduleEdit('calendar') || !state.calendarModal) return;
  const ev = getCalEvent(day, id);
  if(!ev) return;
  const newDay = document.getElementById("cal-day-edit").value;
  ev.t = document.getElementById("cal-title-edit").value.trim() || ev.t;
  ev.time = document.getElementById("cal-time-edit").value.trim() || ev.time;
  ev.k = state.calendarModal.kind || ev.k;
  ev.notes = document.getElementById("cal-notes-edit").value.trim();
  ev.editedBy = currentUser().name;
  ev.editedAt = "Just now";
  if(newDay !== day){
    calendarEvents[day] = calendarEvents[day].filter(e=>e.id!==id);
    if(!calendarEvents[newDay]) calendarEvents[newDay] = [];
    calendarEvents[newDay].push(ev);
    state.calendarModal = { mode:"view", day:newDay, id };
  } else {
    state.calendarModal.mode = "view";
  }
  scheduleRender();
}
// "Whole series" edit — updates the series' own template (so future generated occurrences pick up the
// change too) and cascades the same title/time/kind/notes onto every not-yet-deleted occurrence already
// generated. There's no Day field here since the edit applies across every occurrence's own date.
function saveEventEditSeries(seriesId){
  if(!moduleEdit('calendar') || !state.calendarModal) return;
  const series = calendarSeries[seriesId];
  if(!series) return;
  const title = document.getElementById("cal-title-editseries").value.trim();
  const time = document.getElementById("cal-time-editseries").value.trim();
  const notes = document.getElementById("cal-notes-editseries").value.trim();
  const kind = state.calendarModal.kind || series.kind;
  if(!title || !time) return;
  series.title = title; series.time = time; series.notes = notes; series.kind = kind;
  Object.keys(calendarEvents).forEach(d=>{
    (calendarEvents[d]||[]).forEach(e=>{
      if(e.seriesId===seriesId && !e.deleted){
        e.t = title; e.time = time; e.notes = notes; e.k = kind;
        e.editedBy = currentUser().name; e.editedAt = "Just now";
      }
    });
  });
  const m = state.calendarModal;
  state.calendarModal = { mode:"view", day:m.day, id:m.id };
  scheduleRender();
}
// Deleting an event asks for confirmation first (confirmed with Johnna) — the modal swaps its Edit/
// Delete buttons for an inline "Delete this event? Yes/No" prompt rather than a native confirm(), same
// pattern as the special-instruction delete confirm above. Deletes are soft (deleted:true) so the event
// can be found under "Deleted Events" and restored rather than being lost for good. A recurring event
// asks "just this occurrence, or the whole series?" first — same choice as editing, above.
function requestDeleteEvent(){
