function age(dob){
  const d=new Date(dob), t=nowRef();
  let a=t.getFullYear()-d.getFullYear();
  if(t.getMonth()<d.getMonth() || (t.getMonth()===d.getMonth() && t.getDate()<d.getDate())) a--;
  return a;
}

/* ---------------- Generic per-section edit-lock / save / print (resident profile) ----------------
   Every fillable section across the resident profile (Care Plan's individual fields, Hospice/Home
   Health, Contacts, Overview, and the list-style tabs like Medications/Routines/Visitors) follows one
   shared pattern: an empty section shows a "+ Complete X" prompt; once something's on file, it locks
   to a read-only view with its own small Edit/Save/Print controls, and changes made after tapping Edit
   only take effect once Save is tapped. This is a deliberate change from the old always-autosaving
   Care Plan, and replaces the single whole-tab edit toggle and the old whole-profile-header
   Save/Edit/Print buttons. */
function isSectionEditing(residentId, sectionKey){
  return !!(state.sectionEdit[residentId] && state.sectionEdit[residentId][sectionKey]);
}
function openSectionEdit(residentId, sectionKey){
  if(!moduleEdit('residents')) return;
  if(!state.sectionEdit[residentId]) state.sectionEdit[residentId] = {};
  state.sectionEdit[residentId][sectionKey] = true;
  scheduleRender();
}
let sectionSaveFlashTimer = {};
function saveSectionEdit(residentId, sectionKey){
  if(state.sectionEdit[residentId]) state.sectionEdit[residentId][sectionKey] = false;
  writeSnapshotNow();
  if(!state.sectionSaveFlash[residentId]) state.sectionSaveFlash[residentId] = {};
  state.sectionSaveFlash[residentId][sectionKey] = true;
  scheduleRender();
  const flashKey = residentId+"|"+sectionKey;
  if(sectionSaveFlashTimer[flashKey]) clearTimeout(sectionSaveFlashTimer[flashKey]);
  sectionSaveFlashTimer[flashKey] = setTimeout(()=>{
    if(state.sectionSaveFlash[residentId]) state.sectionSaveFlash[residentId][sectionKey] = false;
    scheduleRender();
  }, 1600);
}
// Populated fresh on every render() by profileSection() below, so a section's own Print button can
// print exactly what's on screen without re-deriving/escaping HTML through an onclick attribute.
let sectionPrintRegistry = {};
function printSectionSheet(residentId, label, bodyHtml){
  const r = residents.find(x=>x.id===residentId);
  if(!r) return;
  document.getElementById("printSheet").innerHTML = `
    <div class="p-head">
      <div><div class="p-brand">New Horizon Homes — ${houses[0].name}</div><h1>${esc(r.name)}</h1></div>
      <div class="p-date">Printed ${TODAY}</div>
    </div>
    <h2>${esc(label)}</h2>
    <div class="p-section-body">${bodyHtml}</div>
  `;
  window.print();
}
function printRegisteredSection(residentId, sectionKey){
  const entry = sectionPrintRegistry[residentId+"|"+sectionKey];
  if(!entry) return;
  printSectionSheet(residentId, entry.label, entry.html);
}
// Care Plan intentionally prints as ONE sheet for the whole tab (see renderCarePlanBody) rather than
// through the per-field sectionPrintRegistry, so this builds the Care Plan's printable summary directly
// from carePlans — the same field-by-field text used in printProfile()'s Care Plan section.
