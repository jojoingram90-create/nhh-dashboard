function renderBreakfastPrefsModal(){
  const list = houseResidents();
  const residentId = state.breakfastPrefsResidentId;
  const resident = list.find(r=>r.id===residentId);
  const plans = residentId ? residentBreakfastPlansFor(residentId) : [];
  const editing = state.breakfastPlanEditingId !== null;
  return `
  <div class="modal-overlay">
    <div class="modal-card recipe-modal">
      <div class="modal-head">
        <div>
          <h2>Breakfast Preferences</h2>
          <span class="hint">Named breakfast plans per resident, each assigned to every day or specific days.</span>
        </div>
        <button class="btn small" onclick="closeBreakfastPrefs()">✕ Close</button>
      </div>
      <div class="recipe-modal-body">
        ${!list.length ? `<span class="hint" style="font-style:italic;">No residents yet.</span>` : `
        <div class="dc-inline-input" style="margin-top:0;"><label style="font-size:12.5px; color:var(--text-faint);">Resident<br>
          <select class="form-select" onchange="setBreakfastPrefsResident(this.value)">
            ${list.map(r=>`<option value="${r.id}" ${residentId===r.id?"selected":""}>${r.name}</option>`).join("")}
